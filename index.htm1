<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#07111f">
<title>Tamim Quiz</title>

<style>
*{
  box-sizing:border-box;
  -webkit-tap-highlight-color:transparent;
}

body{
  margin:0;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Tahoma,Arial,sans-serif;
  background:
    radial-gradient(circle at top,#17335c 0%,#07111f 45%,#030811 100%);
  color:#fff;
  min-height:100vh;
}

button{
  font-family:inherit;
}

.app{
  width:100%;
  max-width:720px;
  margin:auto;
  padding:18px;
  min-height:100vh;
}

.card{
  background:rgba(12,25,45,.88);
  border:1px solid rgba(255,255,255,.09);
  border-radius:26px;
  padding:22px;
  box-shadow:0 20px 60px rgba(0,0,0,.3);
  backdrop-filter:blur(15px);
}

.logo{
  text-align:center;
  font-size:42px;
  margin-top:20px;
  margin-bottom:5px;
}

.title{
  text-align:center;
  font-size:30px;
  font-weight:900;
  margin:0 0 8px;
}

.subtitle{
  text-align:center;
  color:#a9b8ce;
  margin-bottom:25px;
}

.screen{
  display:none;
}

.screen.active{
  display:block;
}

.menu{
  display:grid;
  gap:12px;
}

button{
  border:0;
  cursor:pointer;
  color:white;
  font-size:17px;
  font-weight:800;
  border-radius:17px;
  padding:16px;
  transition:.18s;
}

button:active{
  transform:scale(.97);
}

.primary{
  background:linear-gradient(135deg,#2563eb,#7c3aed);
}

.secondary{
  background:#172942;
  border:1px solid rgba(255,255,255,.08);
}

.success{
  background:linear-gradient(135deg,#059669,#10b981);
}

.danger{
  background:linear-gradient(135deg,#dc2626,#ef4444);
}

.gold{
  background:linear-gradient(135deg,#d97706,#f59e0b);
}

.back{
  margin-bottom:15px;
  background:transparent;
  border:1px solid rgba(255,255,255,.1);
  color:#cbd5e1;
}

.player-list,
.difficulty-list,
.category-list{
  display:grid;
  gap:12px;
}

.player{
  display:flex;
  align-items:center;
  justify-content:space-between;
  background:#12233d;
  padding:16px;
  border-radius:18px;
  border:1px solid rgba(255,255,255,.06);
}

.player-main{
  display:flex;
  align-items:center;
  gap:12px;
  flex:1;
  text-align:right;
}

.player-avatar{
  width:48px;
  height:48px;
  border-radius:50%;
  background:#1e3a5f;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:25px;
}

.player-name{
  font-size:19px;
  font-weight:900;
}

.player-best{
  color:#8ea3bf;
  font-size:12px;
  margin-top:3px;
}

.small-btn{
  padding:10px 13px;
  font-size:14px;
}

.section-title{
  font-size:25px;
  font-weight:900;
  margin:5px 0 18px;
}

.choice{
  display:flex;
  align-items:center;
  gap:12px;
  text-align:right;
}

.choice-icon{
  font-size:28px;
}

.choice-text{
  flex:1;
}

.choice-title{
  font-size:18px;
  font-weight:900;
}

.choice-desc{
  font-size:13px;
  color:#a9b8ce;
  margin-top:3px;
}

.topbar{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:8px;
  margin-bottom:15px;
}

.stat{
  background:#12233d;
  border-radius:15px;
  padding:11px 8px;
  text-align:center;
}

.stat-label{
  color:#91a5bd;
  font-size:11px;
}

.stat-value{
  font-size:20px;
  font-weight:900;
  margin-top:2px;
}

.progress{
  height:9px;
  background:#172942;
  border-radius:20px;
  overflow:hidden;
  margin-bottom:18px;
}

.progress-bar{
  height:100%;
  width:0%;
  background:linear-gradient(90deg,#22c55e,#38bdf8,#8b5cf6);
  transition:.3s;
}

.timer{
  text-align:center;
  font-size:30px;
  font-weight:900;
  margin:5px 0 15px;
}

.timer.warning{
  color:#facc15;
}

.timer.danger{
  color:#ef4444;
}

.question{
  font-size:25px;
  font-weight:900;
  line-height:1.5;
  text-align:center;
  margin:15px 0 20px;
}

.answers{
  display:grid;
  gap:11px;
}

.option{
  background:#132640;
  border:2px solid transparent;
  text-align:right;
  font-size:17px;
}

.option:hover{
  border-color:#3b82f6;
}

.option.correct{
  background:#064e3b;
  border-color:#10b981;
}

.option.wrong{
  background:#5f1010;
  border-color:#ef4444;
}

.option.disabled{
  pointer-events:none;
}

.feedback{
  min-height:35px;
  text-align:center;
  font-size:18px;
  font-weight:900;
  margin-top:15px;
}

.feedback.good{
  color:#34d399;
}

.feedback.bad{
  color:#fb7185;
}

.result{
  text-align:center;
}

.result-emoji{
  font-size:65px;
}

.score-big{
  font-size:55px;
  font-weight:1000;
  margin:5px 0;
}

.result-line{
  color:#a9b8ce;
  margin:8px 0;
}

.leaderboard{
  display:grid;
  gap:10px;
}

.leaderboard-row{
  display:grid;
  grid-template-columns:50px 1fr auto;
  align-items:center;
  gap:10px;
  background:#12233d;
  padding:13px;
  border-radius:16px;
}

.rank{
  font-size:24px;
  text-align:center;
}

.leader-name{
  font-weight:900;
}

.leader-score{
  font-weight:900;
  color:#fbbf24;
}

.achievement-list{
  display:grid;
  gap:10px;
}

.achievement{
  display:flex;
  align-items:center;
  gap:12px;
  background:#12233d;
  padding:15px;
  border-radius:17px;
  opacity:.5;
}

.achievement.unlocked{
  opacity:1;
  border:1px solid rgba(250,204,21,.25);
}

.achievement-icon{
  font-size:30px;
}

.achievement-title{
  font-weight:900;
}

.achievement-desc{
  color:#8fa2bb;
  font-size:12px;
  margin-top:3px;
}

.settings{
  display:grid;
  gap:12px;
}

.settings-row{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:15px;
  background:#12233d;
  padding:16px;
  border-radius:17px;
}

.settings-title{
  font-weight:900;
}

.settings-desc{
  color:#91a5bd;
  font-size:12px;
  margin-top:4px;
}

.toggle{
  width:58px;
  height:32px;
  border-radius:30px;
  padding:4px;
  background:#334155;
}

.toggle.on{
  background:#2563eb;
}

.toggle-circle{
  width:24px;
  height:24px;
  border-radius:50%;
  background:white;
  transition:.2s;
}

.toggle.on .toggle-circle{
  transform:translateX(-26px);
}

.notice{
  background:#172942;
  border-radius:16px;
  padding:14px;
  color:#b7c5d8;
  font-size:13px;
  line-height:1.7;
}

.empty{
  text-align:center;
  color:#91a5bd;
  padding:20px;
}

.footer{
  text-align:center;
  color:#60738d;
  font-size:11px;
  margin:22px 0 5px;
}

@media(max-width:500px){
  .app{
    padding:12px;
  }

  .card{
    padding:17px;
    border-radius:22px;
  }

  .title{
    font-size:27px;
  }

  .question{
    font-size:22px;
  }

  .logo{
    font-size:36px;
  }
}
</style>
</head>

<body>

<div class="app">

<!-- HOME -->
<section id="home" class="screen active">
  <div class="card">

    <div class="logo">🧠🎮</div>
    <h1 class="title">Tamim Quiz</h1>
    <div class="subtitle">لعبة التحدي والذكاء للأطفال</div>

    <div class="menu">

      <button class="primary" onclick="openPlayers()">
        🚀 ابدأ اللعب
      </button>

      <button class="secondary" onclick="openPlayers()">
        👨‍👩‍👧‍👦 اختيار اللاعب
      </button>

      <button class="secondary" onclick="openDifficulty()">
        🧠 اختيار الصعوبة
      </button>

      <button class="secondary" onclick="openCategories()">
        📚 الفئات
      </button>

      <button class="secondary" onclick="showLeaderboard()">
        🏆 لوحة الأبطال
      </button>

      <button class="secondary" onclick="showAchievements()">
        ⭐ إنجازاتي
      </button>

      <button class="secondary" onclick="showSettings()">
        ⚙️ الإعدادات
      </button>

    </div>

    <div class="footer">
      Tamim Quiz 🚀
    </div>

  </div>
</section>


<!-- PLAYERS -->
<section id="players" class="screen">
  <div class="card">

    <button class="back" onclick="showScreen('home')">
      ↩️ رجوع
    </button>

    <div class="section-title">
      👨‍👩‍👧‍👦 اختر اللاعب
    </div>

    <div id="playerList" class="player-list"></div>

    <button class="secondary" style="margin-top:12px" onclick="addPlayer()">
      ➕ لاعب جديد
    </button>

  </div>
</section>


<!-- DIFFICULTY -->
<section id="difficulty" class="screen">
  <div class="card">

    <button class="back" onclick="showScreen('home')">
      ↩️ رجوع
    </button>

    <div class="section-title">
      🧠 اختر مستوى الصعوبة
    </div>

    <div class="difficulty-list">

      <button class="secondary choice" onclick="selectDifficulty('easy')">
        <span class="choice-icon">🟢</span>
        <span class="choice-text">
          <span class="choice-title">سهل</span>
          <span class="choice-desc">100 نقطة للسؤال</span>
        </span>
      </button>

      <button class="secondary choice" onclick="selectDifficulty('medium')">
        <span class="choice-icon">🟡</span>
        <span class="choice-text">
          <span class="choice-title">متوسط</span>
          <span class="choice-desc">200 نقطة للسؤال</span>
        </span>
      </button>

      <button class="secondary choice" onclick="selectDifficulty('hard')">
        <span class="choice-icon">🔴</span>
        <span class="choice-text">
          <span class="choice-title">صعب</span>
          <span class="choice-desc">300 نقطة للسؤال</span>
        </span>
      </button>

      <button class="secondary choice" onclick="selectDifficulty('random')">
        <span class="choice-icon">🎲</span>
        <span class="choice-text">
          <span class="choice-title">عشوائي</span>
          <span class="choice-desc">مزيج من المستويات</span>
        </span>
      </button>

    </div>

  </div>
</section>


<!-- CATEGORIES -->
<section id="categories" class="screen">
  <div class="card">

    <button class="back" onclick="showScreen('home')">
      ↩️ رجوع
    </button>

    <div class="section-title">
      📚 اختر الفئة
    </div>

    <div class="category-list">

      <button class="secondary" onclick="startGame('general')">
        🌍 معلومات عامة
      </button>

      <button class="secondary" onclick="startGame('animals')">
        🐾 حيوانات
      </button>

      <button class="secondary" onclick="startGame('space')">
        🚀 الفضاء
      </button>

      <button class="secondary" onclick="startGame('science')">
        🔬 العلوم
      </button>

      <button class="secondary" onclick="startGame('puzzles')">
        🧩 ألغاز وذكاء
      </button>

      <button class="secondary" onclick="startGame('islam')">
        🕌 إسلاميات للأطفال
      </button>

      <button class="secondary" onclick="startGame('sports')">
        ⚽ رياضة
      </button>

      <button class="secondary" onclick="startGame('fun')">
        😂 أسئلة ممتعة
      </button>

      <button class="gold" onclick="startGame('all')">
        🎲 كل الفئات
      </button>

    </div>

  </div>
</section>


<!-- GAME -->
<section id="game" class="screen">
  <div class="card">

    <div class="topbar">

      <div class="stat">
        <div class="stat-label">اللاعب</div>
        <div id="gamePlayer" class="stat-value">—</div>
      </div>

      <div class="stat">
        <div class="stat-label">النقاط</div>
        <div id="score" class="stat-value">0</div>
      </div>

      <div class="stat">
        <div class="stat-label">السؤال</div>
        <div id="questionNumber" class="stat-value">1/10</div>
      </div>

    </div>

    <div class="progress">
      <div id="progressBar" class="progress-bar"></div>
    </div>

    <div id="timer" class="timer">
      15
    </div>

    <div id="question" class="question">
      —
    </div>

    <div id="answers" class="answers"></div>

    <div id="feedback" class="feedback"></div>

  </div>
</section>


<!-- RESULT -->
<section id="result" class="screen">
  <div class="card result">

    <div id="resultEmoji" class="result-emoji">
      🏆
    </div>

    <div id="resultTitle" class="section-title">
      أحسنت!
    </div>

    <div id="finalScore" class="score-big">
      0
    </div>

    <div class="result-line">
      النقاط
    </div>

    <div id="correctResult" class="result-line">
      الإجابات الصحيحة: 0 / 10
    </div>

    <div id="comboResult" class="result-line">
      أفضل سلسلة: 0 🔥
    </div>

    <div id="successResult" class="result-line">
      نسبة النجاح: 0%
    </div>

    <div class="menu" style="margin-top:20px">

      <button class="primary" onclick="replayGame()">
        🔄 لعب مرة أخرى
      </button>

      <button class="secondary" onclick="showScreen('home')">
        🏠 الرئيسية
      </button>

    </div>

  </div>
</section>


<!-- LEADERBOARD -->
<section id="leaderboard" class="screen">
  <div class="card">

    <button class="back" onclick="showScreen('home')">
      ↩️ رجوع
    </button>

    <div class="section-title">
      🏆 لوحة الأبطال
    </div>

    <div id="leaderboardList" class="leaderboard"></div>

  </div>
</section>


<!-- ACHIEVEMENTS -->
<section id="achievements" class="screen">
  <div class="card">

    <button class="back" onclick="showScreen('home')">
      ↩️ رجوع
    </button>

    <div class="section-title">
      ⭐ إنجازاتي
    </div>

    <div id="achievementList" class="achievement-list"></div>

  </div>
</section>


<!-- SETTINGS -->
<section id="settings" class="screen">
  <div class="card">

    <button class="back" onclick="showScreen('home')">
      ↩️ رجوع
    </button>

    <div class="section-title">
      ⚙️ الإعدادات
    </div>

    <div class="settings">

      <div class="settings-row">

        <div>
          <div class="settings-title">
            🔊 الصوت
          </div>

          <div class="settings-desc">
            الموسيقى والمؤثرات الصوتية
          </div>
        </div>

        <button
          id="soundToggle"
          class="toggle on"
          onclick="toggleSound()"
        >
          <div class="toggle-circle"></div>
        </button>

      </div>

      <div class="notice">
        🎵 الموسيقى والمؤثرات تعمل من داخل اللعبة.
        <br>
        👤 عند اختيار اللاعب يتم نطق اسمه فقط باللغة الإنجليزية.
        <br>
        📝 الأسئلة والإجابات لا يتم نطقها.
      </div>

      <button class="secondary" onclick="testNameSound()">
        🔊 اختبار الصوت
      </button>

    </div>

  </div>
</section>

</div>


<script>

/* =========================
   DATA
========================= */

const questions = [

{q:"ما عاصمة فرنسا؟",t:"Fransa'nın başkenti neresidir?",a:["باريس","لندن","برلين","مدريد"],c:0,cat:"general",d:"easy"},
{q:"كم عدد أيام الأسبوع؟",t:"Bir haftada kaç gün vardır?",a:["5","6","7","8"],c:2,cat:"general",d:"easy"},
{q:"ما أكبر محيط في العالم؟",t:"Dünyanın en büyük okyanusu hangisidir?",a:["الأطلسي","الهندي","الهادئ","المتجمد"],c:2,cat:"general",d:"medium"},
{q:"ما اللغة الأكثر تحدثاً كلغة أم في العالم؟",t:"Dünyada ana dil olarak en çok konuşulan dil hangisidir?",a:["الإنجليزية","الصينية","العربية","الفرنسية"],c:1,cat:"general",d:"medium"},
{q:"كم عدد القارات؟",t:"Dünyada kaç kıta vardır?",a:["5","6","7","8"],c:2,cat:"general",d:"easy"},

{q:"ما أسرع حيوان بري؟",t:"Karada yaşayan en hızlı hayvan hangisidir?",a:["الأسد","الفهد","الحصان","النمر"],c:1,cat:"animals",d:"easy"},
{q:"أي حيوان يُسمى سفينة الصحراء؟",t:"Hangi hayvana çölün gemisi denir?",a:["الجمل","الحصان","الفيل","الغزال"],c:0,cat:"animals",d:"easy"},
{q:"ما أكبر حيوان في العالم؟",t:"Dünyanın en büyük hayvanı hangisidir?",a:["الفيل","الحوت الأزرق","الزرافة","القرش"],c:1,cat:"animals",d:"medium"},
{q:"كم عدد أرجل العنكبوت؟",t:"Bir örümceğin kaç bacağı vardır?",a:["6","8","10","12"],c:1,cat:"animals",d:"easy"},
{q:"أي طائر لا يستطيع الطيران؟",t:"Hangi kuş uçamaz?",a:["الصقر","النسر","البطريق","العصفور"],c:2,cat:"animals",d:"easy"},

{q:"ما الكوكب المعروف بالكوكب الأحمر؟",t:"Kızıl Gezegen olarak bilinen gezegen hangisidir?",a:["الأرض","المريخ","المشتري","زحل"],c:1,cat:"space",d:"easy"},
{q:"ما أقرب كوكب إلى الشمس؟",t:"Güneş'e en yakın gezegen hangisidir?",a:["الزهرة","الأرض","عطارد","المريخ"],c:2,cat:"space",d:"easy"},
{q:"كم عدد كواكب المجموعة الشمسية؟",t:"Güneş Sistemi'nde kaç gezegen vardır?",a:["7","8","9","10"],c:1,cat:"space",d:"easy"},
{q:"ما أكبر كوكب في المجموعة الشمسية؟",t:"Güneş Sistemi'ndeki en büyük gezegen hangisidir?",a:["زحل","الأرض","المشتري","نبتون"],c:2,cat:"space",d:"easy"},
{q:"ما اسم القمر الطبيعي للأرض؟",t:"Dünya'nın doğal uydusunun adı nedir?",a:["القمر","فوبوس","أوروبا","تيتان"],c:0,cat:"space",d:"easy"},

{q:"ما الغاز الذي نتنفسه؟",t:"Nefes alırken hangi gazı kullanırız?",a:["الأكسجين","الهيليوم","الهيدروجين","النيتروجين فقط"],c:0,cat:"science",d:"easy"},
{q:"كم عدد عظام جسم الإنسان تقريباً؟",t:"İnsan vücudunda yaklaşık kaç kemik vardır?",a:["106","206","306","406"],c:1,cat:"science",d:"medium"},
{q:"ما العضو الذي يضخ الدم؟",t:"Kanı vücuda pompalayan organ hangisidir?",a:["الرئة","القلب","المعدة","الكبد"],c:1,cat:"science",d:"easy"},
{q:"ما درجة تجمد الماء؟",t:"Su kaç derecede donar?",a:["0°","10°","50°","100°"],c:0,cat:"science",d:"easy"},
{q:"ما مركز الذرة؟",t:"Atomun merkezine ne ad verilir?",a:["الإلكترون","النواة","البروتون","الغلاف"],c:1,cat:"science",d:"medium"},

{q:"شيء كلما أخذت منه كبر، ما هو؟",t:"Kendisinden aldıkça büyüyen şey nedir?",a:["الحفرة","الكتاب","الماء","الطريق"],c:0,cat:"puzzles",d:"easy"},
{q:"ما الشيء الذي له أسنان ولا يعض؟",t:"Dişleri olduğu halde ısırmayan şey nedir?",a:["الأسد","المشط","الكلب","المنشار"],c:1,cat:"puzzles",d:"easy"},
{q:"شيء يمشي بلا أرجل ويبكي بلا عيون؟",t:"Bacakları olmadan yürüyen ve gözleri olmadan ağlayan şey nedir?",a:["السحاب","الحجر","الكرسي","القلم"],c:0,cat:"puzzles",d:"medium"},
{q:"ما الشيء الذي إذا زاد نقص؟",t:"Arttıkça azalan şey nedir?",a:["العمر","المال","الطعام","الكتاب"],c:0,cat:"puzzles",d:"medium"},
