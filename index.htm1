t:"İki elde toplam kaç parmak vardır?",
a:["8","9","10","12"],
c:2,cat:"fun",d:"easy"
},

{
q:"ما لون السماء في يوم صافٍ؟",
t:"Açık ve bulutsuz bir günde gökyüzü ne renktir?",
a:["أخضر","أزرق","أحمر","برتقالي"],
c:1,cat:"fun",d:"easy"
}

];


/* =========================================================
   GAME STATE
========================================================= */

let players =
JSON.parse(localStorage.getItem("tamimPlayers")) ||
[
  {name:"سيدرا",score:0,games:0,best:0},
  {name:"تميم",score:0,games:0,best:0},
  {name:"شيراز",score:0,games:0,best:0},
  {name:"تيم",score:0,games:0,best:0}
];

let currentPlayer = null;
let difficulty = "random";
let category = "all";

let gameQuestions = [];
let currentIndex = 0;
let score = 0;
let correct = 0;
let combo = 0;
let bestComboRound = 0;
let timer = null;
let timeLeft = 15;
let gameFinished = false;

let soundEnabled =
localStorage.getItem("tamimSound") !== "false";


/* =========================================================
   ELEMENTS
========================================================= */

const screens = [
  "homeScreen",
  "playersScreen",
  "difficultyScreen",
  "categoriesScreen",
  "gameScreen",
  "resultScreen",
  "leaderboardScreen",
  "achievementsScreen",
  "settingsScreen"
];

function hideAll(){

  screens.forEach(id=>{
    document.getElementById(id).classList.add("hidden");
  });

}

function show(id){

  hideAll();

  document.getElementById(id).classList.remove("hidden");

  window.scrollTo({
    top:0,
    behavior:"smooth"
  });

}

function goHome(){

  stopTimer();
  show("homeScreen");

}


/* =========================================================
   PLAYER SYSTEM
========================================================= */

function savePlayers(){

  localStorage.setItem(
    "tamimPlayers",
    JSON.stringify(players)
  );

}

function openPlayers(){

  renderPlayers();

  show("playersScreen");

}

function renderPlayers(){

  const box =
  document.getElementById("playersList");

  box.innerHTML = "";

  players.forEach((p,index)=>{

    const row =
    document.createElement("button");

    row.className = "option player";

    row.innerHTML = `

      <div class="player-info">

        <div class="avatar">
          ${index===0?"👧":index===1?"👦":index===2?"👧":"👦"}
        </div>

        <div>

          <div class="player-name">
            ${escapeHTML(p.name)}
          </div>

          <div class="player-score">
            ⭐ ${p.score} نقطة
            · 🎮 ${p.games} ألعاب
          </div>

        </div>

      </div>

      <div class="badge">
        اختيار
      </div>

    `;

    row.onclick = ()=>{

      currentPlayer = p;

      openDifficulty();

    };

    box.appendChild(row);

  });

}

function addPlayer(){

  const name =
  prompt("اكتب اسم اللاعب الجديد:");

  if(!name) return;

  const clean =
  name.trim();

  if(!clean) return;

  if(
    players.some(
      p=>p.name===clean
    )
  ){

    alert("هذا الاسم موجود بالفعل.");

    return;

  }

  const player = {
    name:clean,
    score:0,
    games:0,
    best:0
  };

  players.push(player);

  savePlayers();

  currentPlayer = player;

  openDifficulty();

}


/* =========================================================
   DIFFICULTY
========================================================= */

function openDifficulty(){

  show("difficultyScreen");

}

function selectDifficulty(value){

  difficulty = value;

  openCategories();

}


/* =========================================================
   CATEGORIES
========================================================= */

function openCategories(){

  show("categoriesScreen");

}


/* =========================================================
   GAME START
========================================================= */

function startGame(cat){

  if(!currentPlayer){

    alert("اختر لاعباً أولاً 👨‍👩‍👧‍👦");

    openPlayers();

    return;

  }

  category = cat;

  let pool =
  questions.filter(q=>{

    const categoryMatch =
      category==="all" ||
      q.cat===category;

    let difficultyMatch = true;

    if(difficulty!=="random"){
      difficultyMatch =
        q.d===difficulty;
    }

    return categoryMatch &&
           difficultyMatch;

  });

  /*
   إذا كان عدد الأسئلة أقل من 10،
   نسمح بالأسئلة من الفئات الأخرى
   بنفس الصعوبة حتى تبقى الجولة 10 أسئلة.
  */

  if(pool.length < 10){

    pool =
    questions.filter(q=>{

      if(category!=="all" &&
         q.cat!==category){
        return false;
      }

      if(difficulty==="random"){
        return true;
      }

      return q.d===difficulty;

    });

  }

  pool =
  shuffle([...pool]);

  /*
   نكرر الأسئلة عند الحاجة فقط
   حتى تصبح الجولة 10 أسئلة.
  */

  gameQuestions = [];

  while(
    gameQuestions.length<10 &&
    pool.length>0
  ){

    gameQuestions.push(
      pool[
        gameQuestions.length % pool.length
      ]
    );

  }

  currentIndex = 0;
  score = 0;
  correct = 0;
  combo = 0;
  bestComboRound = 0;
  gameFinished = false;

  document.getElementById("gamePlayer")
    .textContent =
    currentPlayer.name;

  show("gameScreen");

  loadQuestion();

}


/* =========================================================
   LOAD QUESTION
========================================================= */

function loadQuestion(){

  stopTimer();

  if(currentIndex >= gameQuestions.length){

    finishGame();

    return;

  }

  const q =
  gameQuestions[currentIndex];

  document.getElementById("questionNumber")
    .textContent =
    `${currentIndex+1}/10`;

  document.getElementById("scoreValue")
    .textContent =
    score;

  document.getElementById("progressBar")
    .style.width =
    `${(currentIndex/10)*100}%`;

  document.getElementById("feedback")
    .textContent = "";

  document.getElementById("question")
    .textContent =
    q.q;

  const answers =
  document.getElementById("answers");

  answers.innerHTML = "";

  /*
    نخلط الإجابات، مع الحفاظ على الإجابة الصحيحة.
  */

  const answerObjects =
  q.a.map((text,index)=>({
    text,
    correct:index===q.c
  }));

  const shuffled =
  shuffle(answerObjects);

  shuffled.forEach(item=>{

    const btn =
    document.createElement("button");

    btn.className = "answer";

    btn.textContent =
    item.text;

    btn.onclick = ()=>{
      answerQuestion(
        btn,
        item.correct
      );
    };

    answers.appendChild(btn);

  });

  /*
    الصوت التركي
  */

  speakTurkish(q.t);

  startTimer();

}


/* =========================================================
   ANSWER
========================================================= */

function answerQuestion(button,isCorrect){

  if(gameFinished) return;

  const all =
  document.querySelectorAll(".answer");

  all.forEach(btn=>{
    btn.classList.add("disabled");
  });

  stopTimer();

  const feedback =
  document.getElementById("feedback");

  if(isCorrect){

    button.classList.add("correct");

    correct++;

    combo++;

    if(combo > bestComboRound){
      bestComboRound = combo;
    }

    let points = 100;

    if(difficulty==="medium"){
      points = 200;
    }

    if(difficulty==="hard"){
      points = 300;
    }

    /*
      مكافأة السلسلة
    */

    const bonus =
      combo>=3 ? 50 : 0;

    score += points + bonus;

    document.getElementById("scoreValue")
      .textContent =
      score;

    if(combo>=3){

      feedback.textContent =
      "ممتاز! 🔥 سلسلة قوية!";

      speakTurkish("Harika! Çok iyi gidiyorsun!");

    }else{

      feedback.textContent =
      "إجابة صحيحة! 🎉";

      speakTurkish("Doğru cevap! Harika!");

    }

  }else{

    button.classList.add("wrong");

    combo = 0;

    /*
      نُظهر الإجابة الصحيحة
    */

    all.forEach(btn=>{

      const q =
      gameQuestions[currentIndex];

      if(btn.textContent === q.a[q.c]){

        btn.classList.add("correct");

      }

    });

    feedback.textContent =
    "للأسف، حاول في السؤال التالي 💪";

    speakTurkish("Yanlış cevap. Bir sonraki soruda daha iyisini yapabilirsin.");

  }

  setTimeout(()=>{

    currentIndex++;

    loadQuestion();

  },1100);

}


/* =========================================================
   TIMER
========================================================= */

function startTimer(){

  timeLeft = 15;

  updateTimer();

  timer =
  setInterval(()=>{

    timeLeft--;

    updateTimer();

    if(timeLeft<=0){

      stopTimer();

      timeoutQuestion();

    }

  },1000);

}

function updateTimer(){

  const bar =
  document.getElementById("timerBar");

  const percentage =
  Math.max(0,(timeLeft/15)*100);

  bar.style.width =
  percentage+"%";

}

function stopTimer(){

  if(timer){

    clearInterval(timer);

    timer = null;

  }

}

function timeoutQuestion(){

  const all =
  document.querySelectorAll(".answer");

  all.forEach(btn=>{
    btn.classList.add("disabled");
  });

  const q =
  gameQuestions[currentIndex];

  all.forEach(btn=>{

    if(btn.textContent === q.a[q.c]){

      btn.classList.add("correct");

    }

  });

  combo = 0;

  document.getElementById("feedback")
    .textContent =
    "⏰ انتهى الوقت!";

  speakTurkish("Süre doldu!");

  setTimeout(()=>{

    currentIndex++;

    loadQuestion();

  },1100);

}


/* =========================================================
   FINISH
========================================================= */

function finishGame(){

  stopTimer();

  gameFinished = true;

  if(!currentPlayer) return;

  currentPlayer.score += score;

  currentPlayer.games++;

  if(bestComboRound > currentPlayer.best){

    currentPlayer.best =
    bestComboRound;

  }

  savePlayers();

  document.getElementById("resultScore")
    .textContent =
    score;

  document.getElementById("correctCount")
    .textContent =
    correct;

  document.getElementById("bestCombo")
    .textContent =
    bestComboRound;

  document.getElementById("successRate")
    .textContent =
    Math.round(
      (correct/10)*100
    )+"%";

  document.getElementById("totalQuestions")
    .textContent =
    "10";

  let emoji = "💪";
  let title = "جولة جيدة!";

  if(correct>=9){

    emoji="🏆";
    title="أسطوري!";

  }else if(correct>=7){

    emoji="🔥";
    title="ممتاز!";

  }else if(correct>=5){

    emoji="👏";
    title="أحسنت!";

  }

  document.getElementById("resultEmoji")
    .textContent =
    emoji;

  document.getElementById("resultTitle")
    .textContent =
    `${title} ${currentPlayer.name}`;

  show("resultScreen");

  if(correct>=8){

    speakTurkish(
      "Tebrikler! Harika bir sonuç!"
    );

  }else{

    speakTurkish(
      "Güzel bir oyun! Tekrar deneyebilirsin."
    );

  }

}


/* =========================================================
   REPLAY
========================================================= */

function replayGame(){

  startGame(category);

}


/* =========================================================
   LEADERBOARD
========================================================= */

function showLeaderboard(){

  const sorted =
  [...players].sort(
    (a,b)=>b.score-a.score
  );

  const box =
  document.getElementById("leaderboard");

  box.innerHTML = "";

  if(sorted.length===0){

    box.innerHTML =
    `<div class="small">لا توجد نتائج بعد.</div>`;

  }

  sorted.forEach((p,index)=>{

    const row =
    document.createElement("div");

    row.className =
    "leaderboard-row";

    const medal =
    index===0 ? "🥇":
    index===1 ? "🥈":
    index===2 ? "🥉":
    "🏅";

    row.innerHTML = `

      <div class="rank">
        ${medal}
      </div>

      <div class="leader-name">
        ${escapeHTML(p.name)}
      </div>

      <div class="leader-score">
        ${p.score} ⭐
      </div>

    `;

    box.appendChild(row);

  });

  show("leaderboardScreen");

}


/* =========================================================
   ACHIEVEMENTS
========================================================= */

function showAchievements(){

  const box =
  document.getElementById("achievements");

  box.innerHTML = "";

  const bestScore =
  Math.max(
    0,
    ...players.map(p=>p.score)
  );

  const totalGames =
    players.reduce(
      (sum,p)=>sum+p.games,
      0
    );

  const achievements = [

    {
      icon:"🎮",
      title:"أول لعبة",
      text:"العب أول جولة",
      unlocked:totalGames>=1
    },

    {
      icon:"⭐",
      title:"جامع النقاط",
      text:"اجمع 1000 نقطة",
      unlocked:bestScore>=1000
    },

    {
      icon:"🔥",
      title:"سلسلة نارية",
      text:"احصل على سلسلة من 3 إجابات صحيحة",
      unlocked:
      players.some(p=>p.best>=3)
    },

    {
      icon:"🏆",
      title:"بطل تميم",
      text:"اجمع 3000 نقطة",
      unlocked:bestScore>=3000
    }

  ];

  achievements.forEach(a=>{

    const div =
    document.createElement("div");

    div.className =
    "achievement"+
    (a.unlocked ? "" : " locked");

    div.innerHTML = `

      <div class="achievement-icon">
        ${a.icon}
      </div>

      <div>
        <strong>
          ${a.title}
        </strong>

        <div class="small">
          ${a.text}
        </div>
      </div>

    `;

    box.appendChild(div);

  });

  show("achievementsScreen");

}


/* =========================================================
   SETTINGS
========================================================= */

function showSettings(){

  updateSoundButton();

  checkTurkishVoice();

  show("settingsScreen");

}

function toggleSound(){

  soundEnabled =
  !soundEnabled;

  localStorage.setItem(
    "tamimSound",
    soundEnabled
  );

  updateSoundButton();

}

function updateSoundButton(){

  const btn =
  document.getElementById("soundToggle");

  if(soundEnabled){

    btn.classList.add("active");

  }else{

    btn.classList.remove("active");

  }

}


/* =========================================================
   TURKISH VOICE
========================================================= */

/*
  مهم جداً:

  نحن لا نستخدم الصوت العربي إطلاقاً.

  الكود يبحث عن صوت تركي حقيقي:
  tr-TR

  وإذا لم يجده:
  لا يستخدم صوتاً عربياً كبديل.
*/

function getTurkishVoice(){

  if(
    !("speechSynthesis" in window)
  ){

    return null;

  }

  const voices =
  window.speechSynthesis.getVoices();

  /*
    البحث أولاً عن tr-TR
  */

  let voice =
  voices.find(v=>
    /^tr[-_]TR$/i.test(v.lang)
  );

  /*
    ثم أي صوت تركي
  */

  if(!voice){

    voice =
    voices.find(v=>
      /^tr[-_]/i.test(v.lang)
    );

  }

  /*
    بعض الأجهزة قد تسمي الصوت
    Türkçe أو Turkish
  */

  if(!voice){

    voice =
    voices.find(v=>
      /turkish|türkçe|turk/i.test(v.name)
    );

  }

  return voice || null;

}


/*
  فحص الصوت التركي
*/

function checkTurkishVoice(){

  const box =
  document.getElementById("voiceStatus");

  if(!("speechSynthesis" in window)){

    box.className =
    "notice";

    box.textContent =
    "⚠️ هذا المتصفح لا يدعم تشغيل الصوت بطريقة Web Speech.";

    return;

  }

  const voice =
  getTurkishVoice();

  if(voice){

    box.className =
    "notice success";

    box.innerHTML = `
      🇹🇷 الصوت التركي متوفر ✅
      <br>
      <span class="small">
        ${escapeHTML(voice.name)}
        — ${escapeHTML(voice.lang)}
      </span>
    `;

  }else{

    box.className =
    "notice";

    box.innerHTML = `
      ⚠️ الصوت التركي غير موجود على الجهاز حالياً.
      <br>
      اللعبة <strong>لن تستخدم الصوت العربي</strong>.
      <br>
      فعّل/نزّل صوتاً تركياً من إعدادات الآيفون ثم أغلق الصفحة وافتحها من جديد.
    `;

  }

}


/*
  تشغيل التركية فقط
*/

function speakTurkish(text){

  if(!soundEnabled) return;

  if(
    !("speechSynthesis" in window)
  ) return;

  const voice =
  getTurkishVoice();

  /*
    حماية مهمة:
    لا يوجد صوت تركي = لا تشغيل.
  */

  if(!voice){

    console.warn(
      "Turkish voice is not available."
    );

    return;

  }

  try{

    window.speechSynthesis.cancel();

    const utterance =
    new SpeechSynthesisUtterance(text);

    utterance.voice =
    voice;

    utterance.lang =
    voice.lang || "tr-TR";

    utterance.rate =
    0.88;

    utterance.pitch =
    1.02;

    utterance.volume =
    1;

    window.speechSynthesis.speak(
      utterance
    );

  }catch(error){

    console.error(
      "Turkish speech error:",
      error
    );

  }

}


/*
  iPhone أحياناً يحمل الأصوات
  بعد فترة، لذلك نعيد فحصها.
*/

if(
  "speechSynthesis" in window
){

  window.speechSynthesis
    .onvoiceschanged = ()=>{

      checkTurkishVoice();

    };

}


/* =========================================================
   RESET
========================================================= */

function resetData(){

  const ok =
  confirm(
    "هل تريد مسح جميع نتائج اللاعبين؟"
  );

  if(!ok) return;

  localStorage.removeItem(
    "tamimPlayers"
  );

  localStorage.removeItem(
    "tamimSound"
  );

  location.reload();

}


/* =========================================================
   UTILITIES
========================================================= */

function shuffle(array){

  for(
    let i=array.length-1;
    i>0;
    i--
  ){

    const j =
    Math.floor(
      Math.random()*(i+1)
    );

    [
      array[i],
      array[j]
    ] =
    [
      array[j],
      array[i]
    ];

  }

  return array;

}

function escapeHTML(value){

  return String(value)
    .replaceAll("&","&amp;")
    .replaceAll("<","&lt;")
    .replaceAll(">","&gt;")
    .replaceAll('"',"&quot;")
    .replaceAll("'","&#039;");

}


/* =========================================================
   INITIALIZE
========================================================= */

updateSoundButton();

</script>

</body>
</html>
