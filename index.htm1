<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<title>Tamim Quiz</title>

<style>
*{
  box-sizing:border-box;
  -webkit-tap-highlight-color:transparent;
}

body{
  margin:0;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Tahoma,Arial,sans-serif;
  background:
    radial-gradient(circle at top,#182848 0%,#0b1020 42%,#05070d 100%);
  color:#fff;
  min-height:100vh;
}

button{
  font:inherit;
  cursor:pointer;
}

.app{
  width:100%;
  max-width:760px;
  margin:auto;
  padding:20px 16px 40px;
}

.header{
  text-align:center;
  padding:18px 0 12px;
}

.logo{
  font-size:54px;
  margin-bottom:4px;
}

.title{
  font-size:32px;
  font-weight:900;
  margin:0;
}

.subtitle{
  color:#aeb9d6;
  margin-top:7px;
  font-size:14px;
}

.card{
  background:rgba(17,24,45,.86);
  border:1px solid rgba(255,255,255,.09);
  border-radius:24px;
  padding:20px;
  margin-top:16px;
  box-shadow:0 15px 40px rgba(0,0,0,.28);
  backdrop-filter:blur(12px);
}

.menu{
  display:grid;
  gap:12px;
}

.menu button,
.primary,
.secondary,
.danger{
  width:100%;
  border:0;
  border-radius:17px;
  padding:16px;
  font-weight:800;
  color:#fff;
  transition:.18s;
}

.menu button:active,
.primary:active,
.secondary:active,
.danger:active,
.answer:active{
  transform:scale(.97);
}

.primary{
  background:linear-gradient(135deg,#7c3aed,#2563eb);
}

.secondary{
  background:#1c2745;
}

.danger{
  background:#9f1239;
}

.section-title{
  text-align:center;
  font-size:24px;
  font-weight:900;
  margin:4px 0 18px;
}

.options{
  display:grid;
  gap:12px;
}

.option-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
}

.option{
  background:#17213d;
  border:1px solid rgba(255,255,255,.08);
  border-radius:18px;
  padding:17px 12px;
  color:#fff;
  font-weight:800;
  min-height:70px;
}

.option.selected{
  border:2px solid #8b5cf6;
  background:#29204d;
}

.player{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
  text-align:right;
}

.player-info{
  display:flex;
  align-items:center;
  gap:12px;
}

.avatar{
  width:48px;
  height:48px;
  border-radius:15px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#26345d;
  font-size:25px;
}

.player-name{
  font-size:18px;
  font-weight:900;
}

.player-score{
  font-size:12px;
  color:#9eacce;
}

.badge{
  font-size:12px;
  background:#2c1c52;
  color:#c4b5fd;
  padding:7px 10px;
  border-radius:12px;
}

.topbar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:10px;
  margin-bottom:14px;
}

.stat{
  background:#131d38;
  border-radius:15px;
  padding:9px 12px;
  text-align:center;
  min-width:75px;
}

.stat-label{
  font-size:10px;
  color:#9aa8c7;
}

.stat-value{
  font-size:18px;
  font-weight:900;
}

.progress{
  height:8px;
  background:#18223c;
  border-radius:20px;
  overflow:hidden;
  margin:12px 0 20px;
}

.progress-bar{
  height:100%;
  width:0%;
  background:linear-gradient(90deg,#8b5cf6,#22d3ee);
  transition:.3s;
}

.question{
  font-size:25px;
  line-height:1.5;
  font-weight:900;
  text-align:center;
  margin:20px 0 22px;
}

.answer{
  width:100%;
  border:1px solid rgba(255,255,255,.08);
  background:#17213d;
  color:white;
  padding:16px;
  border-radius:17px;
  font-weight:800;
  min-height:60px;
  transition:.18s;
}

.answer.correct{
  background:#14532d;
  border-color:#22c55e;
}

.answer.wrong{
  background:#7f1d1d;
  border-color:#ef4444;
}

.answer.disabled{
  pointer-events:none;
  opacity:.8;
}

.feedback{
  min-height:42px;
  text-align:center;
  font-weight:900;
  font-size:17px;
  padding:12px 4px;
}

.timer{
  width:100%;
  height:7px;
  background:#18223c;
  border-radius:10px;
  overflow:hidden;
}

.timer-bar{
  height:100%;
  width:100%;
  background:#22c55e;
  transition:width 1s linear;
}

.result{
  text-align:center;
}

.result-emoji{
  font-size:70px;
}

.result-score{
  font-size:45px;
  font-weight:900;
  margin:10px 0;
}

.result-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:10px;
  margin:20px 0;
}

.result-stat{
  background:#131d38;
  border-radius:18px;
  padding:16px;
}

.result-stat strong{
  display:block;
  font-size:25px;
}

.result-stat span{
  color:#9eacce;
  font-size:12px;
}

.leaderboard-row{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:13px;
  border-bottom:1px solid rgba(255,255,255,.06);
}

.rank{
  font-size:21px;
  width:40px;
}

.leader-name{
  flex:1;
  font-weight:900;
}

.leader-score{
  font-weight:900;
  color:#c4b5fd;
}

.achievement{
  display:flex;
  gap:12px;
  align-items:center;
  padding:14px;
  border-radius:17px;
  background:#131d38;
  margin-bottom:10px;
}

.achievement.locked{
  opacity:.4;
}

.achievement-icon{
  font-size:30px;
}

.small{
  color:#94a3c0;
  font-size:13px;
  line-height:1.6;
}

.settings-row{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:15px 4px;
  border-bottom:1px solid rgba(255,255,255,.06);
}

.toggle{
  width:54px;
  height:30px;
  border-radius:20px;
  background:#334155;
  position:relative;
  border:0;
}

.toggle span{
  width:24px;
  height:24px;
  background:white;
  border-radius:50%;
  position:absolute;
  top:3px;
  right:27px;
  transition:.2s;
}

.toggle.active{
  background:#7c3aed;
}

.toggle.active span{
  right:3px;
}

.hidden{
  display:none!important;
}

.back{
  background:transparent;
  border:0;
  color:#aeb9d6;
  font-weight:800;
  margin-bottom:12px;
  padding:8px;
}

.notice{
  background:#3b2a08;
  border:1px solid #8a6411;
  color:#f9d77a;
  padding:13px;
  border-radius:15px;
  font-size:13px;
  line-height:1.6;
  margin-top:12px;
}

.success{
  background:#09351f;
  border:1px solid #16a34a;
  color:#86efac;
}

@media(max-width:520px){
  .option-grid{
    grid-template-columns:1fr;
  }

  .question{
    font-size:22px;
  }

  .title{
    font-size:28px;
  }
}
</style>
</head>

<body>

<div class="app">

  <div class="header">
    <div class="logo">🧠</div>
    <h1 class="title">Tamim Quiz</h1>
    <div class="subtitle">تحدّي المعرفة والذكاء 🚀</div>
  </div>

  <!-- MAIN -->
  <section id="homeScreen" class="card">
    <div class="menu">

      <button class="primary" onclick="openPlayers()">
        🚀 ابدأ اللعب
      </button>

      <button class="secondary" onclick="openPlayers()">
        👨‍👩‍👧‍👦 اختيار اللاعب
      </button>

      <button class="secondary" onclick="openDifficulty()">
        🧠 اختيار الصعوبة
      </button>

      <button class="secondary" onclick="openCategories()">
        📚 الفئات
      </button>

      <button class="secondary" onclick="showLeaderboard()">
        🏆 لوحة الأبطال
      </button>

      <button class="secondary" onclick="showAchievements()">
        ⭐ إنجازاتي
      </button>

      <button class="secondary" onclick="showSettings()">
        ⚙️ الإعدادات
      </button>

    </div>
  </section>


  <!-- PLAYERS -->
  <section id="playersScreen" class="card hidden">

    <button class="back" onclick="goHome()">← الرئيسية</button>

    <div class="section-title">👨‍👩‍👧‍👦 اختر اللاعب</div>

    <div id="playersList"></div>

    <button class="primary" style="margin-top:12px" onclick="addPlayer()">
      ➕ لاعب جديد
    </button>

  </section>


  <!-- DIFFICULTY -->
  <section id="difficultyScreen" class="card hidden">

    <button class="back" onclick="openPlayers()">← رجوع</button>

    <div class="section-title">🧠 اختر الصعوبة</div>

    <div class="options">

      <button class="option" onclick="selectDifficulty('easy')">
        🟢 سهل
        <div class="small">أسئلة بسيطة — 100 نقطة</div>
      </button>

      <button class="option" onclick="selectDifficulty('medium')">
        🟡 متوسط
        <div class="small">تحدّي أكبر — 200 نقطة</div>
      </button>

      <button class="option" onclick="selectDifficulty('hard')">
        🔴 صعب
        <div class="small">للمحترفين — 300 نقطة</div>
      </button>

      <button class="option" onclick="selectDifficulty('random')">
        🎲 عشوائي
        <div class="small">كل مستويات الصعوبة</div>
      </button>

    </div>

  </section>


  <!-- CATEGORIES -->
  <section id="categoriesScreen" class="card hidden">

    <button class="back" onclick="openDifficulty()">← رجوع</button>

    <div class="section-title">📚 اختر الفئة</div>

    <div class="option-grid">

      <button class="option" onclick="startGame('general')">
        🌍 معلومات عامة
      </button>

      <button class="option" onclick="startGame('animals')">
        🐾 حيوانات
      </button>

      <button class="option" onclick="startGame('space')">
        🚀 الفضاء
      </button>

      <button class="option" onclick="startGame('science')">
        🔬 العلوم
      </button>

      <button class="option" onclick="startGame('puzzles')">
        🧩 ألغاز وذكاء
      </button>

      <button class="option" onclick="startGame('islam')">
        🕌 إسلاميات للأطفال
      </button>

      <button class="option" onclick="startGame('sports')">
        ⚽ رياضة
      </button>

      <button class="option" onclick="startGame('fun')">
        😂 أسئلة ممتعة
      </button>

      <button class="option" onclick="startGame('all')" style="grid-column:1/-1">
        🎲 كل الفئات
      </button>

    </div>

  </section>


  <!-- GAME -->
  <section id="gameScreen" class="card hidden">

    <div class="topbar">

      <div class="stat">
        <div class="stat-label">اللاعب</div>
        <div id="gamePlayer" class="stat-value">-</div>
      </div>

      <div class="stat">
        <div class="stat-label">السؤال</div>
        <div id="questionNumber" class="stat-value">1/10</div>
      </div>

      <div class="stat">
        <div class="stat-label">النقاط</div>
        <div id="scoreValue" class="stat-value">0</div>
      </div>

    </div>

    <div class="progress">
      <div id="progressBar" class="progress-bar"></div>
    </div>

    <div class="timer">
      <div id="timerBar" class="timer-bar"></div>
    </div>

    <div id="question" class="question"></div>

    <div id="answers" class="options"></div>

    <div id="feedback" class="feedback"></div>

  </section>


  <!-- RESULT -->
  <section id="resultScreen" class="card hidden">

    <div class="result">

      <div id="resultEmoji" class="result-emoji">🏆</div>

      <div id="resultTitle" class="section-title">
        أحسنت!
      </div>

      <div id="resultScore" class="result-score">
        0
      </div>

      <div>نقطة</div>

      <div class="result-grid">

        <div class="result-stat">
          <strong id="correctCount">0</strong>
          <span>إجابات صحيحة</span>
        </div>

        <div class="result-stat">
          <strong id="bestCombo">0</strong>
          <span>أفضل سلسلة</span>
        </div>

        <div class="result-stat">
          <strong id="successRate">0%</strong>
          <span>نسبة النجاح</span>
        </div>

        <div class="result-stat">
          <strong id="totalQuestions">10</strong>
          <span>عدد الأسئلة</span>
        </div>

      </div>

      <div class="menu">

        <button class="primary" onclick="replayGame()">
          🔄 العب مرة ثانية
        </button>

        <button class="secondary" onclick="goHome()">
          🏠 الرئيسية
        </button>

      </div>

    </div>

  </section>


  <!-- LEADERBOARD -->
  <section id="leaderboardScreen" class="card hidden">

    <button class="back" onclick="goHome()">← الرئيسية</button>

    <div class="section-title">🏆 لوحة الأبطال</div>

    <div id="leaderboard"></div>

  </section>


  <!-- ACHIEVEMENTS -->
  <section id="achievementsScreen" class="card hidden">

    <button class="back" onclick="goHome()">← الرئيسية</button>

    <div class="section-title">⭐ إنجازاتي</div>

    <div id="achievements"></div>

  </section>


  <!-- SETTINGS -->
  <section id="settingsScreen" class="card hidden">

    <button class="back" onclick="goHome()">← الرئيسية</button>

    <div class="section-title">⚙️ الإعدادات</div>

    <div class="settings-row">
      <div>
        <strong>🔊 الصوت التركي</strong>
        <div class="small">قراءة الأسئلة باللغة التركية</div>
      </div>

      <button id="soundToggle" class="toggle active" onclick="toggleSound()">
        <span></span>
      </button>
    </div>

    <div id="voiceStatus" class="notice">
      جاري فحص الصوت التركي...
    </div>

    <div style="margin-top:20px">
      <button class="danger" onclick="resetData()">
        🗑️ مسح بيانات اللعبة
      </button>
    </div>

  </section>

</div>


<script>

/* =========================================================
   DATA
========================================================= */

const questions = [

{
q:"ما عاصمة فرنسا؟",
t:"Fransa'nın başkenti neresidir?",
a:["باريس","لندن","برلين","مدريد"],
c:0,cat:"general",d:"easy"
},

{
q:"كم عدد أيام الأسبوع؟",
t:"Bir haftada kaç gün vardır?",
a:["5","6","7","8"],
c:2,cat:"general",d:"easy"
},

{
q:"ما أكبر محيط في العالم؟",
t:"Dünyanın en büyük okyanusu hangisidir?",
a:["الأطلسي","الهندي","الهادئ","المتجمد"],
c:2,cat:"general",d:"medium"
},

{
q:"ما اللغة الأكثر تحدثاً كلغة أم في العالم؟",
t:"Dünyada ana dil olarak en çok konuşulan dil hangisidir?",
a:["الإنجليزية","الصينية","العربية","الفرنسية"],
c:1,cat:"general",d:"medium"
},

{
q:"كم عدد القارات؟",
t:"Dünyada kaç kıta vardır?",
a:["5","6","7","8"],
c:2,cat:"general",d:"easy"
},

{
q:"ما أسرع حيوان بري؟",
t:"Karada yaşayan en hızlı hayvan hangisidir?",
a:["الأسد","الفهد","الحصان","النمر"],
c:1,cat:"animals",d:"easy"
},

{
q:"أي حيوان يُسمى سفينة الصحراء؟",
t:"Hangi hayvana çölün gemisi denir?",
a:["الجمل","الحصان","الفيل","الغزال"],
c:0,cat:"animals",d:"easy"
},

{
q:"ما أكبر حيوان في العالم؟",
t:"Dünyanın en büyük hayvanı hangisidir?",
a:["الفيل","الحوت الأزرق","الزرافة","القرش"],
c:1,cat:"animals",d:"medium"
},

{
q:"كم عدد أرجل العنكبوت؟",
t:"Bir örümceğin kaç bacağı vardır?",
a:["6","8","10","12"],
c:1,cat:"animals",d:"easy"
},

{
q:"أي طائر لا يستطيع الطيران؟",
t:"Hangi kuş uçamaz?",
a:["الصقر","النسر","البطريق","العصفور"],
c:2,cat:"animals",d:"easy"
},

{
q:"ما الكوكب المعروف بالكوكب الأحمر؟",
t:"Kızıl Gezegen olarak bilinen gezegen hangisidir?",
a:["الأرض","المريخ","المشتري","زحل"],
c:1,cat:"space",d:"easy"
},

{
q:"ما أقرب كوكب إلى الشمس؟",
t:"Güneş'e en yakın gezegen hangisidir?",
a:["الزهرة","الأرض","عطارد","المريخ"],
c:2,cat:"space",d:"easy"
},

{
q:"كم عدد كواكب المجموعة الشمسية؟",
t:"Güneş Sistemi'nde kaç gezegen vardır?",
a:["7","8","9","10"],
c:1,cat:"space",d:"easy"
},

{
q:"ما أكبر كوكب في المجموعة الشمسية؟",
t:"Güneş Sistemi'ndeki en büyük gezegen hangisidir?",
a:["زحل","الأرض","المشتري","نبتون"],
c:2,cat:"space",d:"easy"
},

{
q:"ما اسم القمر الطبيعي للأرض؟",
t:"Dünya'nın doğal uydusunun adı nedir?",
a:["القمر","فوبوس","أوروبا","تيتان"],
c:0,cat:"space",d:"easy"
},

{
q:"ما الغاز الذي نتنفسه؟",
t:"Nefes alırken hangi gazı kullanırız?",
a:["الأكسجين","الهيليوم","الهيدروجين","النيتروجين فقط"],
c:0,cat:"science",d:"easy"
},

{
q:"كم عدد عظام جسم الإنسان تقريباً؟",
t:"İnsan vücudunda yaklaşık kaç kemik vardır?",
a:["106","206","306","406"],
c:1,cat:"science",d:"medium"
},

{
q:"ما العضو الذي يضخ الدم؟",
t:"Kanı vücuda pompalayan organ hangisidir?",
a:["الرئة","القلب","المعدة","الكبد"],
c:1,cat:"science",d:"easy"
},

{
q:"ما درجة تجمد الماء؟",
t:"Su kaç derecede donar?",
a:["0°","10°","50°","100°"],
c:0,cat:"science",d:"easy"
},

{
q:"ما مركز الذرة؟",
t:"Atomun merkezine ne ad verilir?",
a:["الإلكترون","النواة","البروتون","الغلاف"],
c:1,cat:"science",d:"medium"
},

{
q:"شيء كلما أخذت منه كبر، ما هو؟",
t:"Kendisinden aldıkça büyüyen şey nedir?",
a:["الحفرة","الكتاب","الماء","الطريق"],
c:0,cat:"puzzles",d:"easy"
},

{
q:"ما الشيء الذي له أسنان ولا يعض؟",
t:"Dişleri olduğu halde ısırmayan şey nedir?",
a:["الأسد","المشط","الكلب","المنشار"],
c:1,cat:"puzzles",d:"easy"
},

{
q:"شيء يمشي بلا أرجل ويبكي بلا عيون؟",
t:"Bacakları olmadan yürüyen ve gözleri olmadan ağlayan şey nedir?",
a:["السحاب","الحجر","الكرسي","القلم"],
c:0,cat:"puzzles",d:"medium"
},

{
q:"ما الشيء الذي إذا زاد نقص؟",
t:"Arttıkça azalan şey nedir?",
a:["العمر","المال","الطعام","الكتاب"],
c:0,cat:"puzzles",d:"medium"
},

{
q:"له عين ولا يرى، ما هو؟",
t:"Gözü olduğu halde görmeyen şey nedir?",
a:["الإبرة","القمر","الإنسان","الطائر"],
c:0,cat:"puzzles",d:"easy"
},

{
q:"كم عدد الصلوات المفروضة في اليوم؟",
t:"Bir günde kaç vakit farz namaz vardır?",
a:["3","4","5","6"],
c:2,cat:"islam",d:"easy"
},

{
q:"ما أول سورة في القرآن؟",
t:"Kur'an'ın ilk suresi hangisidir?",
a:["البقرة","الفاتحة","الإخلاص","الناس"],
c:1,cat:"islam",d:"easy"
},

{
q:"كم عدد أركان الإسلام؟",
t:"İslam'ın kaç şartı vardır?",
a:["3","4","5","6"],
c:2,cat:"islam",d:"easy"
},

{
q:"في أي شهر يصوم المسلمون؟",
t:"Müslümanlar hangi ayda oruç tutar?",
a:["رجب","شعبان","رمضان","محرم"],
