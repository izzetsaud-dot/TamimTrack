/* =========================
   GAME STATE
========================= */

let players = JSON.parse(localStorage.getItem("tamim_players") || "null");

if(!players){
  players = [
    {name:"سيدرا",score:0,games:0},
    {name:"تميم",score:0,games:0},
    {name:"شيراز",score:0,games:0},
    {name:"تيم",score:0,games:0}
  ];
}

let currentPlayer = null;
let currentDifficulty = "random";
let currentCategory = "all";

let gameQuestions = [];
let currentQuestion = 0;
let score = 0;
let correctAnswers = 0;
let combo = 0;
let bestCombo = 0;
let timeLeft = 15;
let timerInterval = null;
let answered = false;

let soundEnabled =
  localStorage.getItem("tamim_sound") !== "false";


/* =========================
   SCREEN
========================= */

function showScreen(id){

  document.querySelectorAll(".screen")
    .forEach(s => s.classList.remove("active"));

  document.getElementById(id)
    .classList.add("active");

  window.scrollTo({
    top:0,
    behavior:"smooth"
  });
}


/* =========================
   AUDIO SYSTEM
========================= */

/*
  نستخدم أصوات النظام الإنجليزية فقط.
  لا يتم نطق الأسئلة.
  يتم نطق أسماء اللاعبين فقط.
*/

let audioContext = null;

function getAudioContext(){

  if(!audioContext){

    const AC =
      window.AudioContext ||
      window.webkitAudioContext;

    if(AC){
      audioContext = new AC();
    }
  }

  if(audioContext &&
     audioContext.state === "suspended"){

    audioContext.resume();
  }

  return audioContext;
}


/* صوت إلكتروني بسيط */
function beep(
  frequency = 500,
  duration = 0.12,
  type = "sine",
  volume = 0.05
){

  if(!soundEnabled) return;

  const ctx = getAudioContext();

  if(!ctx) return;

  const osc = ctx.createOscillator();
  const gain = ctx.createGain();

  osc.type = type;
  osc.frequency.value = frequency;

  gain.gain.setValueAtTime(
    0.0001,
    ctx.currentTime
  );

  gain.gain.exponentialRampToValueAtTime(
    volume,
    ctx.currentTime + 0.01
  );

  gain.gain.exponentialRampToValueAtTime(
    0.0001,
    ctx.currentTime + duration
  );

  osc.connect(gain);
  gain.connect(ctx.destination);

  osc.start();

  osc.stop(
    ctx.currentTime + duration + 0.03
  );
}


/* زر */
function buttonSound(){

  beep(520,.07,"sine",.035);
}


/* إجابة صحيحة */
function correctSound(){

  beep(660,.09,"sine",.05);

  setTimeout(()=>{
    beep(880,.14,"sine",.05);
  },90);
}


/* إجابة خطأ */
function wrongSound(){

  beep(180,.18,"sawtooth",.045);

  setTimeout(()=>{
    beep(130,.20,"sawtooth",.035);
  },100);
}


/* انتهاء الوقت */
function timeoutSound(){

  beep(180,.15,"square",.045);

  setTimeout(()=>{
    beep(120,.22,"square",.04);
  },150);
}


/* فوز */
function victorySound(){

  const notes = [
    [523,0],
    [659,130],
    [784,260],
    [1046,400]
  ];

  notes.forEach(n=>{
    setTimeout(()=>{
      beep(n[0],.18,"sine",.055);
    },n[1]);
  });
}


/* نطق الاسم فقط باللغة الإنجليزية */
function speakPlayerName(name){

  if(!soundEnabled) return;

  if(!("speechSynthesis" in window)) return;

  const names = {
    "سيدرا":"Sidra",
    "تميم":"Tamim",
    "شيراز":"Shiraz",
    "تيم":"Taim"
  };

  const text =
    names[name] || name;

  window.speechSynthesis.cancel();

  const u =
    new SpeechSynthesisUtterance(text);

  u.lang = "en-US";
  u.rate = .82;
  u.pitch = 1.02;
  u.volume = 1;

  const voices =
    window.speechSynthesis.getVoices();

  const englishVoice =
    voices.find(v =>
      /^en-US/i.test(v.lang)
    ) ||
    voices.find(v =>
      /^en/i.test(v.lang)
    );

  if(englishVoice){
    u.voice = englishVoice;
    u.lang = englishVoice.lang;
  }

  window.speechSynthesis.speak(u);
}


/* اختبار الصوت */
function testNameSound(){

  if(!soundEnabled){
    alert("فعّل الصوت أولاً 🔊");
    return;
  }

  speakPlayerName(
    currentPlayer?.name || "تميم"
  );
}


/* موسيقى خلفية خفيفة */
let musicTimer = null;
let musicStep = 0;

const musicNotes = [
  261.63,
  329.63,
  392.00,
  329.63,
  293.66,
  349.23,
  440.00,
  349.23
];

function startMusic(){

  if(!soundEnabled) return;

  stopMusic();

  musicStep = 0;

  musicTimer = setInterval(()=>{

    if(!soundEnabled) return;

    const note =
      musicNotes[musicStep % musicNotes.length];

    beep(
      note,
      .28,
      "sine",
      .012
    );

    musicStep++;

  },900);
}


function stopMusic(){

  if(musicTimer){
    clearInterval(musicTimer);
    musicTimer = null;
  }
}


/* =========================
   PLAYERS
========================= */

function savePlayers(){

  localStorage.setItem(
    "tamim_players",
    JSON.stringify(players)
  );
}


function openPlayers(){

  renderPlayers();
  showScreen("players");
}


function renderPlayers(){

  const box =
    document.getElementById("playerList");

  box.innerHTML = "";

  players.forEach((p,index)=>{

    const row =
      document.createElement("div");

    row.className = "player";

    row.innerHTML = `

      <div
        class="player-main"
        onclick="choosePlayer(${index})"
      >

        <div class="player-avatar">
          ${["👧","👦","👧","👦"][index % 4]}
        </div>

        <div>
          <div class="player-name">
            ${escapeHtml(p.name)}
          </div>

          <div class="player-best">
            أفضل نتيجة: ${p.score || 0}
          </div>
        </div>

      </div>

      <button
        class="primary small-btn"
        onclick="choosePlayer(${index})"
      >
        اختيار
      </button>
    `;

    box.appendChild(row);
  });
}


function choosePlayer(index){

  buttonSound();

  currentPlayer =
    players[index];

  /*
    عند اختيار الاسم:
    ينطق الاسم فقط
  */
  speakPlayerName(
    currentPlayer.name
  );

  /*
    بعدها ننتقل للصعوبة
  */
  setTimeout(()=>{
    openDifficulty();
  },450);
}


function addPlayer(){

  const name =
    prompt("اكتب اسم اللاعب:");

  if(!name || !name.trim())
    return;

  players.push({
    name:name.trim(),
    score:0,
    games:0
  });

  savePlayers();

  renderPlayers();
}


/* =========================
   DIFFICULTY
========================= */

function openDifficulty(){

  showScreen("difficulty");
}


function selectDifficulty(level){

  buttonSound();

  currentDifficulty =
    level;

  openCategories();
}


/* =========================
   CATEGORIES
========================= */

function openCategories(){

  showScreen("categories");
}


/* =========================
   START GAME
========================= */

function startGame(category = "all"){

  buttonSound();

  if(!currentPlayer){

    /*
      إذا دخل من زر الصعوبة مباشرة
      نطلب اختيار اللاعب
    */

    openPlayers();
    return;
  }

  currentCategory =
    category;

  let pool =
    questions.filter(q => {

      const categoryMatch =
        category === "all" ||
        q.cat === category;

      const difficultyMatch =
        currentDifficulty === "random" ||
        q.d === currentDifficulty;

      return categoryMatch &&
             difficultyMatch;
    });

  /*
    إذا ما وجدنا 10 أسئلة
    نستخدم الفئة فقط
  */
  if(pool.length < 10){

    pool =
      questions.filter(q =>
        category === "all" ||
        q.cat === category
      );
  }

  /*
    وإذا بقي أقل من 10
    نستخدم كل الأسئلة
  */
  if(pool.length < 10){
    pool = [...questions];
  }

  gameQuestions =
    shuffle(pool).slice(0,10);

  currentQuestion = 0;
  score = 0;
  correctAnswers = 0;
  combo = 0;
  bestCombo = 0;

  document.getElementById("gamePlayer")
    .textContent =
    currentPlayer.name;

  document.getElementById("score")
    .textContent = "0";

  showScreen("game");

  startMusic();

  loadQuestion();
}


/* =========================
   LOAD QUESTION
========================= */

function loadQuestion(){

  stopTimer();

  answered = false;

  const q =
    gameQuestions[currentQuestion];

  document.getElementById("question")
    .textContent = q.q;

  document.getElementById("questionNumber")
    .textContent =
    `${currentQuestion + 1}/10`;

  document.getElementById("progressBar")
    .style.width =
    `${(currentQuestion / 10) * 100}%`;

  document.getElementById("feedback")
    .textContent = "";

  document.getElementById("feedback")
    .className = "feedback";

  const answers =
    document.getElementById("answers");

  answers.innerHTML = "";

  /*
    نخلط الإجابات
    ونحافظ على الإجابة الصحيحة
  */

  const answerObjects =
    q.a.map((text,index)=>({
      text,
      originalIndex:index
    }));

  const shuffled =
    shuffle(answerObjects);

  shuffled.forEach(item=>{

    const btn =
      document.createElement("button");

    btn.className = "option";

    btn.textContent =
      item.text;

    btn.onclick = ()=>{
      answerQuestion(
        item.originalIndex,
        btn
      );
    };

    answers.appendChild(btn);
  });

  startTimer();
}


/* =========================
   ANSWER
========================= */

function answerQuestion(
  selectedIndex,
  selectedButton
){

  if(answered) return;

  answered = true;

  stopTimer();

  const q =
    gameQuestions[currentQuestion];

  const options =
    document.querySelectorAll(".option");

  options.forEach(btn=>{
    btn.classList.add("disabled");
  });

  if(selectedIndex === q.c){

    selectedButton.classList.add("correct");

    correctAnswers++;

    combo++;

    if(combo > bestCombo)
      bestCombo = combo;

    let points = 100;

    if(q.d === "medium")
      points = 200;

    if(q.d === "hard")
      points = 300;

    const comboBonus =
      combo > 1
      ? (combo - 1) * 25
      : 0;

    score +=
      points + comboBonus;

    document.getElementById("score")
      .textContent = score;

    const feedback =
      document.getElementById("feedback");

    feedback.className =
      "feedback good";

    feedback.textContent =
      combo > 1
      ? `✅ أحسنت! 🔥 سلسلة ${combo}`
      : "✅ إجابة صحيحة!";

    correctSound();

  }else{

    selectedButton.classList.add("wrong");

    combo = 0;

    options.forEach(btn=>{

      /*
        نبحث عن الإجابة الصحيحة
        ونبرزها بالاعتماد على النص
      */

      if(
        btn.textContent === q.a[q.c]
      ){
        btn.classList.add("correct");
      }

    });

    const feedback =
      document.getElementById("feedback");

    feedback.className =
      "feedback bad";

    feedback.textContent =
      "❌ إجابة خاطئة";

    wrongSound();
  }

  setTimeout(()=>{

    currentQuestion++;

    if(currentQuestion >= 10){
      finishGame();
    }else{
      loadQuestion();
    }

  },1200);
}


/* =========================
   TIMER
========================= */

function startTimer(){

  timeLeft = 15;

  updateTimer();

  timerInterval =
    setInterval(()=>{

      timeLeft--;

      updateTimer();

      if(timeLeft <= 0){

        timeoutQuestion();

      }

    },1000);
}


function updateTimer(){

  const timer =
    document.getElementById("timer");

  timer.textContent =
    timeLeft;

  timer.classList.remove(
    "warning",
    "danger"
  );

  if(timeLeft <= 7)
    timer.classList.add("warning");

  if(timeLeft <= 3)
    timer.classList.add("danger");
}


function stopTimer(){

  if(timerInterval){

    clearInterval(timerInterval);

    timerInterval = null;
  }
}


function timeoutQuestion(){

  if(answered) return;

  answered = true;

  stopTimer();

  combo = 0;

  const q =
    gameQuestions[currentQuestion];

  const options =
    document.querySelectorAll(".option");

  options.forEach(btn=>{
    btn.classList.add("disabled");

    if(btn.textContent === q.a[q.c]){
      btn.classList.add("correct");
    }
  });

  const feedback =
    document.getElementById("feedback");

  feedback.className =
    "feedback bad";

  feedback.textContent =
    "⏰ انتهى الوقت!";

  timeoutSound();

  setTimeout(()=>{

    currentQuestion++;

    if(currentQuestion >= 10){
      finishGame();
    }else{
      loadQuestion();
    }

  },1200);
}


/* =========================
   FINISH
========================= */

function finishGame(){

  stopTimer();
  stopMusic();

  document.getElementById("progressBar")
    .style.width = "100%";

  if(currentPlayer){

    currentPlayer.games =
      (currentPlayer.games || 0) + 1;

    if(
      score >
      (currentPlayer.score || 0)
    ){

      currentPlayer.score =
        score;
    }

    savePlayers();
  }

  const success =
    Math.round(
      (correctAnswers / 10) * 100
    );

  document.getElementById("finalScore")
    .textContent =
    score;

  document.getElementById("correctResult")
    .textContent =
    `الإجابات الصحيحة: ${correctAnswers} / 10`;

  document.getElementById("comboResult")
    .textContent =
    `أفضل سلسلة: ${bestCombo} 🔥`;

  document.getElementById("successResult")
    .textContent =
    `نسبة النجاح: ${success}%`;

  let emoji = "🎮";

  if(success >= 90)
    emoji = "🏆";

  else if(success >= 70)
    emoji = "🥇";

  else if(success >= 50)
    emoji = "🥈";

  else
    emoji = "💪";

  document.getElementById("resultEmoji")
    .textContent = emoji;

  document.getElementById("resultTitle")
    .textContent =
    success >= 70
    ? "أحسنت يا بطل! 🎉"
    : "حاول مرة ثانية! 💪";

  showScreen("result");

  victorySound();
}


/* =========================
   REPLAY
========================= */

function replayGame(){

  startGame(
    currentCategory
  );
}


/* =========================
   LEADERBOARD
========================= */

function showLeaderboard(){

  const box =
    document.getElementById(
      "leaderboardList"
    );

  box.innerHTML = "";

  const sorted =
    [...players].sort(
      (a,b)=>
        (b.score || 0) -
        (a.score || 0)
    );

  if(!sorted.length){

    box.innerHTML =
      `<div class="empty">
        لا توجد نتائج بعد 🎮
      </div>`;

  }else{

    sorted.forEach((p,index)=>{

      const row =
        document.createElement("div");

      row.className =
        "leaderboard-row";

      const medals =
        ["🥇","🥈","🥉"];

      row.innerHTML = `

        <div class="rank">
          ${medals[index] || "🏅"}
        </div>

        <div>
          <div class="leader-name">
            ${escapeHtml(p.name)}
          </div>
          <div class="player-best">
            ${p.games || 0} جولات
          </div>
        </div>

        <div class="leader-score">
          ${p.score || 0}
        </div>

      `;

      box.appendChild(row);
    });
  }

  showScreen("leaderboard");
}


/* =========================
   ACHIEVEMENTS
========================= */

function showAchievements(){

  const box =
    document.getElementById(
      "achievementList"
    );

  box.innerHTML = "";

  const totalGames =
    players.reduce(
      (sum,p)=>
        sum + (p.games || 0),
      0
    );

  const maxScore =
    Math.max(
      0,
      ...players.map(
        p => p.score || 0
      )
    );

  const achievements = [

    {
      icon:"🎮",
      title:"أول لعبة",
      desc:"العب أول جولة",
      unlocked:
        totalGames >= 1
    },

    {
      icon:"🔥",
      title:"بداية قوية",
      desc:"احصل على 500 نقطة أو أكثر",
      unlocked:
        maxScore >= 500
    },

    {
      icon:"🏆",
      title:"بطل",
      desc:"احصل على 1000 نقطة أو أكثر",
      unlocked:
        maxScore >= 1000
    },

    {
      icon:"⭐",
      title:"محترف",
      desc:"احصل على 2000 نقطة أو أكثر",
      unlocked:
        maxScore >= 2000
    }

  ];

  achievements.forEach(a=>{

    const row =
      document.createElement("div");

    row.className =
      "achievement" +
      (a.unlocked
        ? " unlocked"
        : "");

    row.innerHTML = `

      <div class="achievement-icon">
        ${a.icon}
      </div>

      <div>
        <div class="achievement-title">
          ${a.title}
        </div>

        <div class="achievement-desc">
          ${a.desc}
        </div>
      </div>

    `;

    box.appendChild(row);
  });

  showScreen("achievements");
}


/* =========================
   SETTINGS
========================= */

function showSettings(){

  updateSoundButton();

  showScreen("settings");
}


function toggleSound(){

  soundEnabled =
    !soundEnabled;

  localStorage.setItem(
    "tamim_sound",
    soundEnabled
  );

  updateSoundButton();

  if(soundEnabled){

    buttonSound();

    startMusic();

  }else{

    stopMusic();

    if(
      "speechSynthesis" in window
    ){
      speechSynthesis.cancel();
    }
  }
}


function updateSoundButton(){

  const btn =
    document.getElementById(
      "soundToggle"
    );

  if(!btn) return;

  btn.classList.toggle(
    "on",
    soundEnabled
  );
}


/* =========================
   UTILITIES
========================= */

function shuffle(array){

  const arr =
    [...array];

  for(
    let i = arr.length - 1;
    i > 0;
    i--
  ){

    const j =
      Math.floor(
        Math.random() * (i + 1)
      );

    [
      arr[i],
      arr[j]
    ] =
    [
      arr[j],
      arr[i]
    ];
  }

  return arr;
}


function escapeHtml(text){

  return String(text)
    .replace(/&/g,"&amp;")
    .replace(/</g,"&lt;")
    .replace(/>/g,"&gt;")
    .replace(/"/g,"&quot;")
    .replace(/'/g,"&#039;");
}


/* =========================
   INITIALIZE
========================= */

document.addEventListener(
  "click",
  ()=>{
    getAudioContext();
  },
  {once:true}
);

window.speechSynthesis?.addEventListener?.(
  "voiceschanged",
  ()=>{
    window.speechSynthesis.getVoices();
  }
);

updateSoundButton();

</script>

</body>
</html>
