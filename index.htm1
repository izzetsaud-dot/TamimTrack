<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>Tamim Quiz</title>

<style>
*{box-sizing:border-box}
body{
  margin:0;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif;
  background:linear-gradient(135deg,#090d1a,#111a32);
  color:#fff;
  min-height:100vh;
}
button{
  font:inherit;
  border:0;
  cursor:pointer;
}
.app{
  width:100%;
  max-width:650px;
  margin:auto;
  min-height:100vh;
  padding:18px;
}
header{
  text-align:center;
  padding:20px 0 15px;
}
.logo{
  font-size:48px;
}
h1{
  margin:5px 0;
  font-size:32px;
}
.subtitle{
  color:#aab5d0;
}
.screen{display:none}
.screen.active{display:block}
.card{
  background:rgba(255,255,255,.07);
  border:1px solid rgba(255,255,255,.1);
  border-radius:22px;
  padding:20px;
  margin-bottom:15px;
  box-shadow:0 10px 30px rgba(0,0,0,.2);
}
.menu{
  display:grid;
  gap:12px;
}
.btn{
  width:100%;
  padding:16px;
  border-radius:16px;
  color:#fff;
  background:#24304d;
  transition:.15s;
  font-weight:700;
}
.btn:hover{transform:translateY(-2px)}
.btn.primary{background:linear-gradient(135deg,#6c5ce7,#8e44ad)}
.btn.green{background:#159957}
.btn.yellow{background:#d49b16}
.btn.red{background:#c0392b}
.btn.blue{background:#1769aa}
.back{
  background:transparent;
  color:#aab5d0;
  margin-bottom:12px;
}
.grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
}
.player{
  padding:20px 10px;
  border-radius:18px;
  background:#202b47;
  color:white;
  font-size:20px;
  font-weight:bold;
}
.player span{
  display:block;
  font-size:35px;
  margin-bottom:7px;
}
.question{
  font-size:24px;
  line-height:1.5;
  font-weight:800;
  text-align:center;
  margin:15px 0 22px;
}
.answers{
  display:grid;
  gap:12px;
}
.answer{
  background:#202b47;
  color:#fff;
  padding:17px;
  border-radius:15px;
  font-size:18px;
  font-weight:700;
  text-align:right;
}
.answer.correct{
  background:#168a4a;
}
.answer.wrong{
  background:#b83232;
}
.answer.disabled{
  pointer-events:none;
}
.topbar{
  display:flex;
  justify-content:space-between;
  gap:10px;
  margin-bottom:15px;
}
.badge{
  background:#202b47;
  padding:9px 13px;
  border-radius:12px;
}
.progress{
  height:8px;
  background:#26314c;
  border-radius:10px;
  overflow:hidden;
  margin-bottom:20px;
}
.progress div{
  height:100%;
  background:#7c5cff;
  width:0;
  transition:.3s;
}
.timer{
  text-align:center;
  font-size:28px;
  font-weight:bold;
  margin-bottom:10px;
}
.result-score{
  font-size:48px;
  font-weight:900;
  text-align:center;
  margin:15px;
}
.stat{
  display:flex;
  justify-content:space-between;
  padding:12px 0;
  border-bottom:1px solid rgba(255,255,255,.08);
}
.small{
  color:#9da9c4;
  font-size:14px;
}
.toggle{
  display:flex;
  justify-content:space-between;
  align-items:center;
}
input[type=checkbox]{
  width:22px;
  height:22px;
}
.empty{
  text-align:center;
  color:#aab5d0;
  padding:20px;
}
@media(max-width:450px){
  .grid{grid-template-columns:1fr}
  h1{font-size:28px}
  .question{font-size:21px}
}
</style>
</head>

<body>

<div class="app">

<header>
  <div class="logo">🚀</div>
  <h1>Tamim Quiz</h1>
  <div class="subtitle">لعبة التحدي العائلية 🏆</div>
</header>

<!-- الرئيسية -->
<section id="home" class="screen active">
  <div class="card">
    <div class="menu">
      <button class="btn primary" onclick="goPlayers()">🚀 ابدأ اللعب</button>
      <button class="btn" onclick="goPlayers()">👨‍👩‍👧‍👦 اختيار اللاعب</button>
      <button class="btn" onclick="goDifficulty()">🧠 اختيار الصعوبة</button>
      <button class="btn" onclick="goCategories()">📚 الفئات</button>
      <button class="btn" onclick="showLeaderboard()">🏆 لوحة الأبطال</button>
      <button class="btn" onclick="showAchievements()">⭐ إنجازاتي</button>
      <button class="btn" onclick="showSettings()">⚙️ الإعدادات</button>
    </div>
  </div>
</section>

<!-- اللاعبين -->
<section id="players" class="screen">
  <button class="btn back" onclick="home()">← الرئيسية</button>

  <div class="card">
    <h2>👨‍👩‍👧‍👦 اختر اللاعب</h2>
    <div class="grid">
      <button class="player" onclick="selectPlayer('سيدرا','Sidra')">
        <span>👧</span>سيدرا
      </button>
      <button class="player" onclick="selectPlayer('تميم','Tamim')">
        <span>👦</span>تميم
      </button>
      <button class="player" onclick="selectPlayer('شيراز','Shiraz')">
        <span>👧</span>شيراز
      </button>
      <button class="player" onclick="selectPlayer('تيم','Taim')">
        <span>👦</span>تيم
      </button>
      <button class="player" onclick="newPlayer()">
        <span>➕</span>لاعب جديد
      </button>
    </div>
  </div>
</section>

<!-- الصعوبة -->
<section id="difficulty" class="screen">
  <button class="btn back" onclick="home()">← الرئيسية</button>

  <div class="card">
    <h2>🧠 اختر الصعوبة</h2>
    <div class="menu">
      <button class="btn green" onclick="selectDifficulty('easy')">
        🟢 سهل — 100 نقطة
      </button>
      <button class="btn yellow" onclick="selectDifficulty('medium')">
        🟡 متوسط — 200 نقطة
      </button>
      <button class="btn red" onclick="selectDifficulty('hard')">
        🔴 صعب — 300 نقطة
      </button>
      <button class="btn blue" onclick="selectDifficulty('random')">
        🎲 عشوائي
      </button>
    </div>
  </div>
</section>

<!-- الفئات -->
<section id="categories" class="screen">
  <button class="btn back" onclick="home()">← الرئيسية</button>

  <div class="card">
    <h2>📚 اختر الفئة</h2>
    <div class="menu">
      <button class="btn" onclick="selectCategory('general')">🌍 معلومات عامة</button>
      <button class="btn" onclick="selectCategory('animals')">🐾 حيوانات</button>
      <button class="btn" onclick="selectCategory('space')">🚀 الفضاء</button>
      <button class="btn" onclick="selectCategory('science')">🔬 العلوم</button>
      <button class="btn" onclick="selectCategory('puzzles')">🧩 ألغاز وذكاء</button>
      <button class="btn" onclick="selectCategory('islam')">🕌 إسلاميات للأطفال</button>
      <button class="btn" onclick="selectCategory('sports')">⚽ رياضة</button>
      <button class="btn" onclick="selectCategory('fun')">😂 أسئلة ممتعة</button>
      <button class="btn primary" onclick="selectCategory('all')">🎲 كل الفئات</button>
    </div>
  </div>
</section>

<!-- اللعبة -->
<section id="game" class="screen">
  <div class="topbar">
    <div class="badge">👤 <span id="gamePlayer"></span></div>
    <div class="badge">⭐ <span id="score">0</span></div>
  </div>

  <div class="progress">
    <div id="progressBar"></div>
  </div>

  <div class="timer">⏱️ <span id="timer">20</span></div>

  <div class="card">
    <div class="small" id="questionNumber"></div>
    <div class="question" id="question"></div>
    <div class="answers" id="answers"></div>
  </div>
</section>

<!-- النتيجة -->
<section id="result" class="screen">
  <div class="card">
    <h2 style="text-align:center">🏆 انتهت اللعبة!</h2>
    <div class="result-score" id="finalScore">0</div>

    <div class="stat">
      <span>✅ الإجابات الصحيحة</span>
      <b id="finalCorrect">0</b>
    </div>

    <div class="stat">
      <span>🔥 أفضل سلسلة</span>
      <b id="finalCombo">0</b>
    </div>

    <div class="stat">
      <span>📊 نسبة النجاح</span>
      <b id="finalPercent">0%</b>
    </div>

    <br>

    <div class="menu">
      <button class="btn primary" onclick="startGame()">🔄 العب مرة أخرى</button>
      <button class="btn" onclick="home()">🏠 الرئيسية</button>
    </div>
  </div>
</section>

<!-- الأبطال -->
<section id="leaderboard" class="screen">
  <button class="btn back" onclick="home()">← الرئيسية</button>

  <div class="card">
    <h2>🏆 لوحة الأبطال</h2>
    <div id="leaderboardList"></div>
  </div>
</section>

<!-- الإنجازات -->
<section id="achievements" class="screen">
  <button class="btn back" onclick="home()">← الرئيسية</button>

  <div class="card">
    <h2>⭐ إنجازاتي</h2>
    <div id="achievementList"></div>
  </div>
</section>

<!-- الإعدادات -->
<section id="settings" class="screen">
  <button class="btn back" onclick="home()">← الرئيسية</button>

  <div class="card">
    <h2>⚙️ الإعدادات</h2>

    <div class="stat toggle">
      <span>🔊 الأصوات</span>
      <input id="soundToggle" type="checkbox" checked onchange="toggleSound()">
    </div>

    <br>

    <button class="btn red" onclick="resetData()">
      🗑️ مسح بيانات اللعبة
    </button>
  </div>
</section>

</div>

<script>

/* =========================
   الأسئلة
========================= */

const questions = [

{q:"ما عاصمة فرنسا؟",a:["باريس","لندن","برلين","مدريد"],c:0,cat:"general",d:"easy"},
{q:"كم عدد أيام الأسبوع؟",a:["5","6","7","8"],c:2,cat:"general",d:"easy"},
{q:"ما أكبر محيط في العالم؟",a:["الأطلسي","الهندي","الهادئ","المتجمد"],c:2,cat:"general",d:"medium"},
{q:"ما اللغة الأكثر تحدثاً كلغة أم في العالم؟",a:["الإنجليزية","الصينية","العربية","الفرنسية"],c:1,cat:"general",d:"medium"},
{q:"كم عدد القارات؟",a:["5","6","7","8"],c:2,cat:"general",d:"easy"},

{q:"ما أسرع حيوان بري؟",a:["الأسد","الفهد","الحصان","النمر"],c:1,cat:"animals",d:"easy"},
{q:"أي حيوان يُسمى سفينة الصحراء؟",a:["الجمل","الحصان","الفيل","الغزال"],c:0,cat:"animals",d:"easy"},
{q:"ما أكبر حيوان في العالم؟",a:["الفيل","الحوت الأزرق","الزرافة","القرش"],c:1,cat:"animals",d:"medium"},
{q:"كم عدد أرجل العنكبوت؟",a:["6","8","10","12"],c:1,cat:"animals",d:"easy"},
{q:"أي طائر لا يستطيع الطيران؟",a:["الصقر","النسر","البطريق","العصفور"],c:2,cat:"animals",d:"easy"},

{q:"ما الكوكب المعروف بالكوكب الأحمر؟",a:["الأرض","المريخ","المشتري","زحل"],c:1,cat:"space",d:"easy"},
{q:"ما أقرب كوكب إلى الشمس؟",a:["الزهرة","الأرض","عطارد","المريخ"],c:2,cat:"space",d:"easy"},
{q:"كم عدد كواكب المجموعة الشمسية؟",a:["7","8","9","10"],c:1,cat:"space",d:"easy"},
{q:"ما أكبر كوكب في المجموعة الشمسية؟",a:["زحل","الأرض","المشتري","نبتون"],c:2,cat:"space",d:"easy"},
{q:"ما اسم القمر الطبيعي للأرض؟",a:["القمر","فوبوس","أوروبا","تيتان"],c:0,cat:"space",d:"easy"},

{q:"ما الغاز الذي نتنفسه؟",a:["الأكسجين","الهيليوم","الهيدروجين","النيتروجين فقط"],c:0,cat:"science",d:"easy"},
{q:"كم عدد عظام جسم الإنسان تقريباً؟",a:["106","206","306","406"],c:1,cat:"science",d:"medium"},
{q:"ما العضو الذي يضخ الدم؟",a:["الرئة","القلب","المعدة","الكبد"],c:1,cat:"science",d:"easy"},
{q:"ما درجة تجمد الماء؟",a:["0°","10°","50°","100°"],c:0,cat:"science",d:"easy"},
{q:"ما مركز الذرة؟",a:["الإلكترون","النواة","البروتون","الغلاف"],c:1,cat:"science",d:"medium"},

{q:"شيء كلما أخذت منه كبر، ما هو؟",a:["الحفرة","الكتاب","الماء","الطريق"],c:0,cat:"puzzles",d:"easy"},
{q:"ما الشيء الذي له أسنان ولا يعض؟",a:["الأسد","المشط","الكلب","المنشار"],c:1,cat:"puzzles",d:"easy"},
{q:"شيء يمشي بلا أرجل ويبكي بلا عيون؟",a:["السحاب","الحجر","الكرسي","القلم"],c:0,cat:"puzzles",d:"medium"},
{q:"ما الشيء الذي إذا زاد نقص؟",a:["العمر","المال","الطعام","الكتاب"],c:0,cat:"puzzles",d:"medium"},
{q:"له عين ولا يرى، ما هو؟",a:["الإبرة","القمر","الإنسان","الطائر"],c:0,cat:"puzzles",d:"easy"},

{q:"كم عدد الصلوات المفروضة في اليوم؟",a:["3","4","5","6"],c:2,cat:"islam",d:"easy"},
{q:"ما أول سورة في القرآن؟",a:["البقرة","الفاتحة","الإخلاص","الناس"],c:1,cat:"islam",d:"easy"},
{q:"كم عدد أركان الإسلام؟",a:["3","4","5","6"],c:2,cat:"islam",d:"easy"},
{q:"في أي شهر يصوم المسلمون؟",a:["رجب","شعبان","رمضان","محرم"],c:2,cat:"islam",d:"easy"},
{q:"ما قبلة المسلمين؟",a:["المسجد النبوي","الكعبة","المسجد الأقصى","جبل عرفات"],c:1,cat:"islam",d:"easy"},

{q:"كم لاعباً في فريق كرة القدم داخل الملعب؟",a:["9","10","11","12"],c:2,cat:"sports",d:"easy"},
{q:"ما الرياضة التي يستخدم فيها المضرب والكرة الصفراء؟",a:["كرة القدم","التنس","السباحة","الجري"],c:1,cat:"sports",d:"easy"},
{q:"كم حلقة في شعار الألعاب الأولمبية؟",a:["4","5","6","7"],c:1,cat:"sports",d:"medium"},
{q:"ما الرياضة التي تُلعب على الجليد بالعصي؟",a:["هوكي الجليد","كرة القدم","التنس","الجولف"],c:0,cat:"sports",d:"medium"},
{q:"كم شوطاً في مباراة كرة القدم؟",a:["1","2","3","4"],c:1,cat:"sports",d:"easy"},

{q:"ما لون الموز غالباً عندما ينضج؟",a:["أزرق","أصفر","بنفسجي","أسود"],c:1,cat:"fun",d:"easy"},
{q:"أي حاسة نستخدمها لرؤية الأشياء؟",a:["السمع","الشم","البصر","اللمس"],c:2,cat:"fun",d:"easy"},
{q:"ما الحيوان الذي يقول مياو؟",a:["الكلب","القطة","الحصان","البقرة"],c:1,cat:"fun",d:"easy"},
{q:"كم إصبعاً في اليدين معاً؟",a:["8","9","10","12"],c:2,cat:"fun",d:"easy"},
{q:"ما لون السماء في يوم صافٍ؟",a:["أخضر","أزرق","أحمر","برتقالي"],c:1,cat:"fun",d:"easy"}

];


/* =========================
   حالة اللعبة
========================= */

let currentPlayer = null;
let currentDifficulty = "easy";
let currentCategory = "all";

let roundQuestions = [];
let currentQuestion = 0;
let score = 0;
let correct = 0;
let combo = 0;
let bestCombo = 0;
let timer = null;
let timeLeft = 20;

let soundEnabled =
  localStorage.getItem("tamim_sound") !== "false";


/* =========================
   التنقل
========================= */

function hideAll(){
  document.querySelectorAll(".screen")
    .forEach(s=>s.classList.remove("active"));
}

function show(id){
  hideAll();
  document.getElementById(id).classList.add("active");
  window.scrollTo(0,0);
}

function home(){
  stopMusic();
  show("home");
}

function goPlayers(){
  buttonSound();
  show("players");
}

function goDifficulty(){
  buttonSound();

  if(!currentPlayer){
    show("players");
    return;
  }

  show("difficulty");
}

function goCategories(){
  buttonSound();

  if(!currentPlayer){
    show("players");
    return;
  }

  show("categories");
}


/* =========================
   اللاعب
========================= */

function selectPlayer(arabic,english){

  buttonSound();

  currentPlayer={
    name:arabic,
    english:english
  };

  speakName(english);

  setTimeout(()=>{
    show("difficulty");
  },500);
}

function newPlayer(){

  const name=prompt("اكتب اسم اللاعب:");

  if(!name || !name.trim()) return;

  currentPlayer={
    name:name.trim(),
    english:name.trim()
  };

  speakName(currentPlayer.english);

  setTimeout(()=>{
    show("difficulty");
  },500);
}


/* =========================
   الصعوبة والفئة
========================= */

function selectDifficulty(d){

  buttonSound();

  currentDifficulty=d;
  show("categories");
}

function selectCategory(cat){

  buttonSound();

  currentCategory=cat;
  startGame();
}


/* =========================
   بدء اللعبة
========================= */

function startGame(){

  if(!currentPlayer){
    show("players");
    return;
  }

  let pool=questions.filter(q=>{

    const difficultyOK =
      currentDifficulty==="random" ||
      q.d===currentDifficulty;

    const categoryOK =
      currentCategory==="all" ||
      q.cat===currentCategory;

    return difficultyOK && categoryOK;
  });

  if(pool.length<10){

    pool=questions.filter(q=>{
      return currentCategory==="all" ||
             q.cat===currentCategory;
    });
  }

  if(pool.length<10){
    pool=[...questions];
  }

  pool.sort(()=>Math.random()-.5);

  roundQuestions=pool.slice(0,10);

  currentQuestion=0;
  score=0;
  correct=0;
  combo=0;
  bestCombo=0;

  document.getElementById("gamePlayer").textContent=
    currentPlayer.name;

  show("game");

  startMusic();

  renderQuestion();
}


/* =========================
   السؤال
========================= */

function renderQuestion(){

  clearInterval(timer);

  const q=roundQuestions[currentQuestion];

  document.getElementById("questionNumber").textContent=
    "السؤال "+(currentQuestion+1)+" من "+roundQuestions.length;

  document.getElementById("question").textContent=q.q;

  document.getElementById("score").textContent=score;

  document.getElementById("progressBar").style.width=
    ((currentQuestion/roundQuestions.length)*100)+"%";

  const box=document.getElementById("answers");
  box.innerHTML="";

  let answers=q.a.map((text,index)=>({
    text,
    original:index
  }));

  answers.sort(()=>Math.random()-.5);

  answers.forEach(item=>{

    const b=document.createElement("button");

    b.className="answer";
    b.textContent=item.text;

    b.onclick=()=>answer(item.original,b);

    box.appendChild(b);
  });

  timeLeft=20;
  document.getElementById("timer").textContent=timeLeft;

  timer=setInterval(()=>{

    timeLeft--;

    document.getElementById("timer").textContent=timeLeft;

    if(timeLeft<=0){

      clearInterval(timer);

      timeoutSound();

      disableAnswers();

      setTimeout(nextQuestion,800);
    }

  },1000);
}


/* =========================
   الإجابة
========================= */

function answer(index,button){

  clearInterval(timer);

  disableAnswers();

  const q=roundQuestions[currentQuestion];

  if(index===q.c){

    button.classList.add("correct");

    correct++;
    combo++;

    if(combo>bestCombo)
      bestCombo=combo;

    let points=100;

    if(currentDifficulty==="medium")
      points=200;

    if(currentDifficulty==="hard")
      points=300;

    if(currentDifficulty==="random"){

      if(q.d==="medium") points=200;
      else if(q.d==="hard") points=300;
    }

    score += points + Math.max(0,combo-1)*25;

    correctSound();

  }else{

    button.classList.add("wrong");

    combo=0;

    const buttons=document.querySelectorAll(".answer");

    buttons.forEach((b,i)=>{
      if(q.a[i] && i===q.c)
        b.classList.add("correct");
    });

    wrongSound();
  }

  document.getElementById("score").textContent=score;

  setTimeout(nextQuestion,900);
}

function disableAnswers(){

  document.querySelectorAll(".answer")
    .forEach(b=>b.classList.add("disabled"));
}


/* =========================
   التالي
========================= */

function nextQuestion(){

  currentQuestion++;

  if(currentQuestion>=roundQuestions.length){

    finishGame();
    return;
  }

  renderQuestion();
}


/* =========================
   النهاية
========================= */

function finishGame(){

  clearInterval(timer);
  stopMusic();
  victorySound();

  const percent=Math.round(
    (correct/roundQuestions.length)*100
  );

  document.getElementById("finalScore").textContent=
    score+" نقطة";

  document.getElementById("finalCorrect").textContent=
    correct+" / "+roundQuestions.length;

  document.getElementById("finalCombo").textContent=
    bestCombo;

  document.getElementById("finalPercent").textContent=
    percent+"%";

  saveResult();

  show("result");
}


/* =========================
   حفظ النتائج
========================= */

function saveResult(){

  let data=
    JSON.parse(localStorage.getItem("tamim_scores")||"{}");

  const name=currentPlayer.name;

  if(!data[name])
    data[name]={
      score:0,
      games:0,
      correct:0,
      bestCombo:0
    };

  data[name].score+=score;
  data[name].games++;
  data[name].correct+=correct;

  if(bestCombo>data[name].bestCombo)
    data[name].bestCombo=bestCombo;

  localStorage.setItem(
    "tamim_scores",
    JSON.stringify(data)
  );
}


/* =========================
   لوحة الأبطال
========================= */

function showLeaderboard(){

  buttonSound();

  const box=document.getElementById("leaderboardList");

  const data=
    JSON.parse(localStorage.getItem("tamim_scores")||"{}");

  const entries=Object.entries(data)
    .sort((a,b)=>b[1].score-a[1].score);

  if(entries.length===0){

    box.innerHTML=
      '<div class="empty">لا توجد نتائج بعد 🏆</div>';

  }else{

    box.innerHTML=entries.map((e,i)=>{

      const medal=
        i===0?"🥇":
        i===1?"🥈":
        i===2?"🥉":"🏅";

      return `
        <div class="stat">
          <span>${medal} ${e[0]}</span>
          <b>${e[1].score} نقطة</b>
        </div>
      `;

    }).join("");
  }

  show("leaderboard");
}


/* =========================
   الإنجازات
========================= */

function showAchievements(){

  buttonSound();

  const box=document.getElementById("achievementList");

  const data=
    JSON.parse(localStorage.getItem("tamim_scores")||"{}");

  let games=0;
  let totalCorrect=0;
  let best=0;

  Object.values(data).forEach(x=>{
    games+=x.games;
    totalCorrect+=x.correct;
    best=Math.max(best,x.bestCombo);
  });

  const achievements=[
    ["🎮","أول لعبة",games>=1],
    ["🔥","سلسلة 3 إجابات صحيحة",best>=3],
    ["🔥🔥","سلسلة 5 إجابات صحيحة",best>=5],
    ["🏆","لعب 5 مباريات",games>=5],
    ["⭐","أكثر من 20 إجابة صحيحة",totalCorrect>=20]
  ];

  box.innerHTML=achievements.map(a=>`
    <div class="stat">
      <span>${a[0]} ${a[1]}</span>
      <b>${a[2]?"✅":"🔒"}</b>
    </div>
  `).join("");

  show("achievements");
}


/* =========================
   الإعدادات
========================= */

function showSettings(){

  buttonSound();

  document.getElementById("soundToggle").checked=
    soundEnabled;

  show("settings");
}

function toggleSound(){

  soundEnabled=
    document.getElementById("soundToggle").checked;

  localStorage.setItem(
    "tamim_sound",
    soundEnabled
  );

  if(soundEnabled)
    buttonSound();
}

function resetData(){

  if(confirm("هل تريد مسح جميع نتائج اللعبة؟")){

    localStorage.removeItem("tamim_scores");

    alert("تم مسح البيانات ✅");
  }
}


/* =========================
   الصوت
========================= */

let audioContext=null;
let musicTimer=null;

function getAudio(){

  if(!audioContext){

    audioContext=
      new (window.AudioContext ||
           window.webkitAudioContext)();
  }

  if(audioContext.state==="suspended")
    audioContext.resume();

  return audioContext;
}

function beep(freq,duration,type="sine",volume=.08){

  if(!soundEnabled) return;

  const ctx=getAudio();

  const osc=ctx.createOscillator();
  const gain=ctx.createGain();

  osc.type=type;
  osc.frequency.value=freq;

  gain.gain.setValueAtTime(
    volume,
    ctx.currentTime
  );

  gain.gain.exponentialRampToValueAtTime(
    .001,
    ctx.currentTime+duration
  );

  osc.connect(gain);
  gain.connect(ctx.destination);

  osc.start();
  osc.stop(ctx.currentTime+duration);
}

function buttonSound(){
  beep(500,.08,"sine",.05);
}

function correctSound(){

  beep(660,.12,"sine",.08);

  setTimeout(()=>{
    beep(880,.18,"sine",.08);
  },100);
}

function wrongSound(){

  beep(180,.25,"sawtooth",.08);
}

function timeoutSound(){

  beep(120,.35,"square",.07);
}

function victorySound(){

  if(!soundEnabled) return;

  [523,659,784,1046].forEach((f,i)=>{
    setTimeout(()=>{
      beep(f,.18,"sine",.08);
    },i*130);
  });
}


/* =========================
   موسيقى الخلفية
========================= */

function startMusic(){

  if(!soundEnabled) return;

  stopMusic();

  const notes=[261.63,329.63,392,329.63];

  let i=0;

  musicTimer=setInterval(()=>{

    beep(
      notes[i%notes.length],
      .20,
      "triangle",
      .018
    );

    i++;

  },700);
}

function stopMusic(){

  if(musicTimer){

    clearInterval(musicTimer);
    musicTimer=null;
  }
}


/* =========================
   نطق اسم اللاعب بالإنجليزية
========================= */

function speakName(name){

  if(!soundEnabled) return;

  if(!("speechSynthesis" in window))
    return;

  window.speechSynthesis.cancel();

  const utterance=
    new SpeechSynthesisUtterance(name);

  utterance.lang="en-US";
  utterance.rate=.85;
  utterance.pitch=1;

  const voices=
    window.speechSynthesis.getVoices();

  const english=
    voices.find(v=>
      v.lang &&
      v.lang.toLowerCase().startsWith("en")
    );

  if(english)
    utterance.voice=english;

  window.speechSynthesis.speak(utterance);
}


/* =========================
   تشغيل أولي
========================= */

document.addEventListener("click",()=>{
  try{
    getAudio();
  }catch(e){}
},{once:true});

if("speechSynthesis" in window){
  window.speechSynthesis.getVoices();
}

</script>

</body>
</html>
