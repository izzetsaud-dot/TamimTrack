* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, sans-serif;
  background: #f3f4f6;
  color: #111827;
}

.app {
  max-width: 600px;
  margin: auto;
  padding: 20px 16px 40px;
}

.header {
  text-align: center;
  margin-bottom: 20px;
}

.header h1 {
  margin: 0;
  font-size: 32px;
}

.header p {
  margin: 8px 0 0;
  color: #6b7280;
}

.total-card {
  background: #111827;
  color: white;
  padding: 25px;
  border-radius: 22px;
  margin-bottom: 18px;
  text-align: center;
  box-shadow: 0 10px 25px rgba(0,0,0,0.12);
}

.total-card span {
  display: block;
  opacity: 0.8;
  margin-bottom: 8px;
}

.total-card strong {
  font-size: 36px;
}

.card {
  background: white;
  padding: 20px;
  border-radius: 20px;
  margin-bottom: 18px;
  box-shadow: 0 5px 18px rgba(0,0,0,0.07);
}

.card h2 {
  margin-top: 0;
}

label {
  display: block;
  margin: 14px 0 6px;
  font-weight: bold;
}

input,
select {
  width: 100%;
  padding: 14px;
  border: 1px solid #d1d5db;
  border-radius: 12px;
  font-size: 16px;
  background: white;
}

button {
  width: 100%;
  margin-top: 18px;
  padding: 14px;
  border: none;
  border-radius: 12px;
  background: #111827;
  color: white;
  font-size: 17px;
  font-weight: bold;
}

button:active {
  transform: scale(0.98);
}

.section-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-title span {
  background: #e5e7eb;
  padding: 5px 10px;
  border-radius: 20px;
}

.expense-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  padding: 14px 0;
  border-bottom: 1px solid #e5e7eb;
}

.expense-item:last-child {
  border-bottom: none;
}

.expense-item strong {
  display: block;
}

.expense-item small {
  display: block;
  margin-top: 5px;
  color: #6b7280;
}

.expense-item button {
  width: auto;
  margin: 0;
  padding: 8px 10px;
  background: #fee2e2;
  color: #991b1b;
}

.empty {
  text-align: center;
  color: #6b7280;
  padding: 20px 0;
}
